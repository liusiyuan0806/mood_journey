/* ===== 情绪手账 · 温暖色调设计系统 ===== */

page {
  background: #FFF8F2;
  color: #4A3A32;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ===== 通用容器 ===== */
.page {
  padding: 28rpx 30rpx 60rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* ===== 卡片 ===== */
.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(200, 130, 90, 0.08);
  border: 1rpx solid rgba(232, 133, 106, 0.06);
}

/* ===== 区块标题 ===== */
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A3A32;
  margin: 36rpx 0 20rpx;
  letter-spacing: 0.5rpx;
}

.section-title .muted {
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 10rpx;
}

/* ===== 辅助文字 ===== */
.muted {
  color: #B5A69C;
  font-size: 25rpx;
  line-height: 1.5;
}

/* ===== 主按钮 ===== */
.primary-btn {
  background: linear-gradient(135deg, #F09070 0%, #E8856A 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  box-shadow: 0 8rpx 20rpx rgba(232, 133, 106, 0.25);
  letter-spacing: 2rpx;
}

.primary-btn::after {
  border: none;
}

.primary-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ===== 次级按钮 ===== */
.secondary-btn {
  background: #FFF1E6;
  color: #E8856A;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 80rpx;
}

.secondary-btn::after {
  border: none;
}

/* ===== 标签 / 胶囊 ===== */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: #FFF1E6;
  color: #E8856A;
  border-radius: 30rpx;
  font-size: 24rpx;
}

/* ===== 分割线 ===== */
.divider {
  height: 1rpx;
  background: #F3E6DD;
  margin: 24rpx 0;
}

/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  color: #B5A69C;
  padding: 60rpx 0;
  font-size: 26rpx;
}

/* ===== 渐变背景工具类 ===== */
.bg-warm-gradient {
  background: linear-gradient(135deg, #FFF8F2 0%, #FFEFE0 100%);
}

.bg-peach-gradient {
  background: linear-gradient(135deg, #FFE8DD 0%, #FFF8F2 100%);
}

/* ===== 文字颜色工具类 ===== */
.text-primary { color: #E8856A; }
.text-secondary { color: #8B776B; }
.text-muted { color: #B5A69C; }
.text-dark { color: #4A3A32; }
.text-gold { color: #F0B27A; }

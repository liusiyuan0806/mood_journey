/* ===== 晴雨表 · 温暖色调 ===== */

/* 情绪健康指数卡片 */
.score {
  padding: 32rpx 30rpx;
  background: linear-gradient(135deg, #FFE8DD 0%, #FFFFFF 60%, #FFF1E6 100%);
  position: relative;
  overflow: hidden;
}

.score::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 160rpx;
  height: 160rpx;
  background: radial-gradient(circle, rgba(240, 178, 122, 0.2) 0%, transparent 70%);
  border-radius: 50%;
}

.score .muted {
  font-size: 24rpx;
  color: #8B776B;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.score-line {
  margin: 12rpx 0 20rpx;
  display: flex;
  align-items: baseline;
}

.score-line text:first-child {
  font-size: 76rpx;
  font-weight: 800;
  color: #E8856A;
  letter-spacing: -2rpx;
  line-height: 1;
}

.score-line text:last-child {
  margin-left: 12rpx;
  color: #8B776B;
  font-size: 26rpx;
}

/* 进度条 */
.progress {
  height: 16rpx;
  background: #F5E6DB;
  border-radius: 20rpx;
  overflow: hidden;
}

.progress view {
  height: 100%;
  background: linear-gradient(90deg, #F0B27A 0%, #E8856A 100%);
  border-radius: 20rpx;
  transition: width 0.5s ease;
  box-shadow: 0 2rpx 6rpx rgba(232, 133, 106, 0.3);
}

.formula {
  font-size: 20rpx;
  color: #B5A69C;
  margin-top: 20rpx;
  line-height: 1.5;
}

/* 标签页 */
.tabs {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin: 32rpx 0 24rpx;
  background: #FFF1E6;
  border-radius: 40rpx;
  padding: 6rpx;
}

.tabs text {
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  color: #8B776B;
  border-radius: 36rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.tabs .active {
  background: #FFFFFF;
  color: #E8856A;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(232, 133, 106, 0.12);
}

/* 图表卡片 */
.chart {
  padding: 28rpx 24rpx;
}

/* 柱状图 */
.line-bars {
  height: 240rpx;
  display: flex;
  gap: 12rpx;
  align-items: flex-end;
  padding-top: 20rpx;
}

.line-item {
  height: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  font-size: 20rpx;
  color: #B5A69C;
  gap: 10rpx;
}

.bar-value {
  width: 28rpx;
  background: linear-gradient(180deg, #F0B27A 0%, #E8856A 100%);
  border-radius: 14rpx 14rpx 4rpx 4rpx;
  min-height: 12rpx;
  transition: height 0.5s ease;
  box-shadow: 0 2rpx 6rpx rgba(232, 133, 106, 0.2);
}

/* 天气关联 */
.weather-row {
  display: grid;
  grid-template-columns: 60rpx 1fr 72rpx;
  align-items: center;
  gap: 16rpx;
  margin: 18rpx 0;
  font-size: 26rpx;
}

.weather-row > text:first-child {
  color: #5D4A40;
  font-weight: 500;
}

.weather-row > view {
  background: #FFF1E6;
  border-radius: 10rpx;
  height: 20rpx;
  overflow: hidden;
}

.weather-bar {
  height: 100%;
  background: linear-gradient(90deg, #F0B27A, #E8856A);
  border-radius: 10rpx;
  transition: width 0.5s ease;
}

.weather-row > text:last-child {
  text-align: right;
  color: #E8856A;
  font-weight: 600;
  font-size: 24rpx;
}

/* 警告提示 */
.alert {
  background: linear-gradient(135deg, #FFF1E9 0%, #FFE8DD 100%);
  color: #B86B4E;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-top: 28rpx;
  font-size: 26rpx;
  line-height: 1.6;
  border: 1rpx solid rgba(232, 133, 106, 0.15);
  position: relative;
  padding-left: 60rpx;
}

.alert::before {
  content: '💛';
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  margin-top: 80rpx;
  padding: 50rpx 30rpx;
  text-align: center;
  color: #8B776B;
  font-size: 26rpx;
  line-height: 1.7;
}

.empty button {
  margin-top: 28rpx;
  width: 60%;
  margin-left: auto;
  margin-right: auto;
}

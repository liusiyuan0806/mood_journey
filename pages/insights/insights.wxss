.score{padding:32rpx;background:linear-gradient(135deg,#FFE1D2,#FFF)}.score-line{margin:10rpx 0}.score-line text:first-child{font-size:80rpx;font-weight:800;color:#F07558}.score-line text:last-child{margin-left:15rpx;color:#786763}.progress{height:16rpx;background:#F5D8CB;border-radius:20rpx;overflow:hidden}.progress view{height:100%;background:#F28262;border-radius:20rpx}.formula{font-size:21rpx;color:#9B918E;margin-top:25rpx}.tabs{display:flex;justify-content:space-around;margin:32rpx 0}.tabs text{padding:13rpx 35rpx}.tabs .active{background:#FFE1D4;color:#D65D42;border-radius:40rpx}.chart{padding:25rpx}.line-bars{height:230rpx;display:flex;gap:15rpx;align-items:flex-end}.line-item{height:100%;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;font-size:18rpx;color:#958987}.bar-value{width:22rpx;background:#F4A072;border-radius:12rpx 12rpx 0 0;min-height:12rpx}.weather-row{display:grid;grid-template-columns:60rpx 1fr 72rpx;align-items:center;gap:14rpx;margin:18rpx 0}.weather-row>view{background:#F7ECE6;border-radius:9rpx}.weather-bar{height:20rpx;background:#F4A072;border-radius:9rpx}.alert{background:#FFF1E9;color:#A65C47;border-radius:20rpx;padding:24rpx;margin-top:25rpx}.empty{margin-top:90rpx;padding:45rpx 30rpx;text-align:center;color:#8A7A75}.empty button{margin-top:28rpx}

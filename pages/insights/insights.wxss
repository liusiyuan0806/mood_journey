/* ===== 晴雨表 · 三模块优化 ===== */

/* ===== EHI 情绪健康指数卡片 ===== */
.ehi-card {
  padding: 32rpx 30rpx 24rpx;
  background: linear-gradient(135deg, #FFE8DD 0%, #FFFFFF 60%, #FFF1E6 100%);
  position: relative;
  overflow: hidden;
}

.ehi-card::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 160rpx;
  height: 160rpx;
  background: radial-gradient(circle, rgba(240, 178, 122, 0.2) 0%, transparent 70%);
  border-radius: 50%;
}

.ehi-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.ehi-title {
  font-size: 26rpx;
  color: #8B776B;
  font-weight: 500;
}

.ehi-trend-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.ehi-trend-arrow {
  font-size: 26rpx;
  font-weight: 700;
}

.ehi-main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 16rpx 0 24rpx;
  position: relative;
  z-index: 1;
}

.ehi-score-block {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.ehi-score {
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
  transition: color 0.3s ease;
}

.ehi-score-unit {
  font-size: 26rpx;
  color: #B5A69C;
  font-weight: 500;
}

.ehi-level-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

/* ===== Gauge ===== */
.gauge {
  position: relative;
  margin: 8rpx 0 10rpx;
}

.gauge-track {
  display: flex;
  height: 16rpx;
  border-radius: 8rpx;
  overflow: hidden;
  box-shadow: inset 0 1rpx 3rpx rgba(0,0,0,0.04);
}

.gauge-zone {
  height: 100%;
}

.gauge-pointer {
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  transition: left 0.5s ease;
  z-index: 2;
}

.gauge-pointer-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.15);
}

.gauge-labels {
  display: flex;
  justify-content: space-around;
  margin-top: 10rpx;
}

.gauge-label {
  font-size: 20rpx;
  color: #B5A69C;
}

/* ===== Advice ===== */
.ehi-advice {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(232, 133, 106, 0.06);
  border-radius: 16rpx;
}

.ehi-advice-icon {
  font-size: 26rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.ehi-advice-text {
  font-size: 24rpx;
  color: #6B5A50;
  line-height: 1.6;
  flex: 1;
}

/* ===== Breakdown toggle ===== */
.ehi-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 12rpx;
  font-size: 24rpx;
  color: #B5A69C;
}

.ehi-toggle-arrow {
  font-size: 24rpx;
  transition: transform 0.3s ease;
}

/* ===== Breakdown detail ===== */
.ehi-breakdown {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F3E6DD;
}

.bd-row {
  margin-bottom: 16rpx;
}

.bd-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.bd-label {
  font-size: 24rpx;
  color: #6B5A50;
}

.bd-value {
  font-size: 26rpx;
  font-weight: 700;
}

.bd-bar {
  height: 10rpx;
  background: #F5E6DB;
  border-radius: 5rpx;
  overflow: hidden;
}

.bd-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.5s ease;
}

.bd-formula {
  font-size: 20rpx;
  color: #C5B6AC;
  margin-top: 12rpx;
  text-align: center;
  line-height: 1.5;
}

/* ===== Tabs (preserved) ===== */
.tabs {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin: 32rpx 0 24rpx;
  background: #FFF1E6;
  border-radius: 40rpx;
  padding: 6rpx;
}

.tabs text {
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  color: #8B776B;
  border-radius: 36rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.tabs .active {
  background: #FFFFFF;
  color: #E8856A;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(232, 133, 106, 0.12);
}

/* ===== Section title row ===== */
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 0 20rpx;
}

.section-title-row .section-title {
  margin: 0;
}

/* ===== Fixed window tag (7-day only) ===== */
.window-fixed-tag {
  padding: 8rpx 22rpx;
  font-size: 22rpx;
  color: #E8856A;
  background: #FFF1E6;
  border-radius: 20rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  flex-shrink: 0;
}

.trend-range-text {
  display: block;
  font-size: 22rpx;
  color: #B5A69C;
  margin: -12rpx 0 20rpx;
  letter-spacing: 0.5rpx;
}

/* ===== Chart card (preserved) ===== */
.chart {
  padding: 28rpx 24rpx;
  overflow: visible;
}

/* ===== Trend chart ===== */
.trend-chart {
  height: 300rpx;
  display: flex;
  gap: 8rpx;
  align-items: flex-end;
  position: relative;
}

.trend-bar-col {
  height: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  position: relative;
  gap: 8rpx;
  min-width: 0;
}

.trend-bar-badges {
  width: 100%;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.tbb-weather,
.tbb-mood,
.tbb-empty {
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

.tbb-weather {
  opacity: 0.95;
}

.tbb-mood {
  opacity: 0.9;
}

.tbb-empty {
  font-size: 22rpx;
  color: #C5B6AC;
}

.trend-bar-track {
  width: 100%;
  flex: 1;
  min-height: 60rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  border-radius: 12rpx;
  position: relative;
  max-width: 56rpx;
  margin: 0 auto;
  border: 2rpx solid;
  box-sizing: border-box;
  overflow: hidden;
}

.trend-bar-empty .trend-bar-track {
  background: rgba(240,240,240,0.55) !important;
  border-color: rgba(210,210,210,0.70) !important;
}

.trend-bar-empty .trend-bar-fill {
  display: none;
}

.trend-bar-empty .tbb-empty {
  color: #C5B6AC;
  font-size: 22rpx;
  line-height: 40rpx;
}

.trend-bar-fill {
  width: 100%;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  min-height: 12rpx;
  transition: height 0.4s ease;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 4rpx;
}

.trend-bar-score {
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 700;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.15);
}

.trend-rain-mark,
.trend-snow-mark {
  position: absolute;
  top: -18rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
}

.trend-bar-date {
  font-size: 18rpx;
  color: #B5A69C;
  white-space: nowrap;
  overflow: hidden;
}

/* ===== Trend popup ===== */
.trend-popup {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-bottom: 14rpx;
  z-index: 20;
  width: 240rpx;
}

.tp-arrow {
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 10rpx solid #FFFFFF;
}

.tp-content {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tp-date {
  font-size: 22rpx;
  color: #B5A69C;
  font-weight: 500;
}

.tp-mood {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A3A32;
}

.tp-weather {
  font-size: 22rpx;
  color: #6B5A50;
}

.tp-hint {
  font-size: 20rpx;
  color: #E8856A;
  margin-top: 4rpx;
}

/* ===== Trend legend ===== */
.trend-legend {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F3E6DD;
}

.tl-section {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tl-section-title {
  font-size: 22rpx;
  color: #8B776B;
  font-weight: 600;
}

.tl-items {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 18rpx;
}

.tl-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tl-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 5rpx;
  border: 2rpx solid transparent;
  box-shadow: inset 0 0 0 1rpx rgba(0,0,0,0.04);
}

.tl-item text {
  font-size: 22rpx;
  color: #6B5A50;
}

/* ===== Weather conclusion ===== */
.wc-conclusion {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, rgba(232,133,106,0.06) 0%, rgba(255,241,230,0.6) 100%);
  border: 1rpx solid rgba(232,133,106,0.1);
}

.wc-icon {
  font-size: 28rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.wc-text {
  font-size: 25rpx;
  color: #5D4A40;
  line-height: 1.6;
  flex: 1;
}

/* ===== Weather group cards ===== */
.weather-groups {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wg-card {
  padding: 22rpx 24rpx;
  transition: transform 0.15s ease;
}

.wg-card:active {
  transform: scale(0.98);
}

.wg-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wg-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.wg-icon {
  font-size: 32rpx;
}

.wg-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A3A32;
}

.wg-count {
  font-size: 22rpx;
  color: #B5A69C;
  background: rgba(255,255,255,0.6);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}

.wg-right {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.wg-score {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}

.wg-unit {
  font-size: 22rpx;
  color: #B5A69C;
}

.wg-moods {
  display: flex;
  gap: 10rpx;
  margin: 14rpx 0 12rpx;
  flex-wrap: wrap;
}

.wg-mood-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.wg-mood-emoji {
  font-size: 22rpx;
}

.wg-mood-pct {
  font-size: 22rpx;
  font-weight: 600;
  color: #5D4A40;
}

.wg-bar {
  height: 8rpx;
  background: #F5E6DB;
  border-radius: 4rpx;
  overflow: hidden;
}

.wg-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

/* ===== Temperature heat strip ===== */
.temp-heat-card {
  padding: 28rpx 24rpx;
}

.th-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.th-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A3A32;
}

.th-badges {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.th-badge {
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.th-best {
  background: rgba(123, 201, 125, 0.15);
  color: #5DA85F;
}

.th-attention {
  background: rgba(232, 133, 106, 0.12);
  color: #C76A52;
}

.th-strip {
  display: flex;
  height: 88rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #F3E6DD;
}

.th-segment {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: transform 0.15s ease;
}

.th-segment:active {
  transform: scaleY(0.96);
}

.th-segment + .th-segment {
  border-left: 1rpx solid rgba(255, 255, 255, 0.35);
}

.th-empty {
  background: #F0F0F0 !important;
}

.th-seg-score {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.12);
}

.th-scale {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 0 4rpx;
}

.th-scale text {
  font-size: 18rpx;
  color: #B5A69C;
  width: 40rpx;
  text-align: center;
}

.th-hint {
  font-size: 22rpx;
  color: #B5A69C;
  text-align: center;
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F3E6DD;
}

/* ===== Chart explanation text ===== */
.chart-explain {
  font-size: 22rpx;
  color: #8B776B;
  line-height: 1.7;
  margin-bottom: 20rpx;
  padding: 14rpx 18rpx;
  background: rgba(232, 133, 106, 0.04);
  border-radius: 12rpx;
  border-left: 4rpx solid rgba(232, 133, 106, 0.2);
}

/* ===== Radar chart ===== */
.radar-card {
  padding: 28rpx 24rpx;
}

.radar-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A3A32;
  margin-bottom: 16rpx;
}

.radar-chart-area {
  position: relative;
  width: 560rpx;
  height: 560rpx;
  margin: 70rpx auto 30rpx;
}

.radar-canvas {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 560rpx;
  height: 560rpx;
}

.radar-label {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  transform: translate(-50%, -50%);
  padding: 8rpx 12rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 12rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.06);
  z-index: 5;
}

.rl-insufficient {
  opacity: 0.45;
}

.rl-icon-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.rl-icon {
  font-size: 24rpx;
}

.rl-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #4A3A32;
}

.rl-count {
  font-size: 18rpx;
  color: #8B776B;
  white-space: nowrap;
}

/* Radar legend */
.radar-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F3E6DD;
}

.rleg-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rleg-line {
  width: 28rpx;
  height: 0;
  border-top: 3rpx solid #E8856A;
}

.rleg-dash {
  border-top: 3rpx dashed #C5B6AC;
}

.rleg-item text {
  font-size: 22rpx;
  color: #6B5A50;
}

.rleg-hint {
  font-size: 20rpx;
  color: #B5A69C;
}

/* ===== Personalized conclusion ===== */
.temp-conclusion-card {
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, rgba(232,133,106,0.06) 0%, rgba(255,241,230,0.8) 100%);
  border: 1rpx solid rgba(232,133,106,0.12);
}

.tcc-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.tcc-icon {
  font-size: 30rpx;
}

.tcc-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A3A32;
}

.tcc-text {
  font-size: 25rpx;
  color: #5D4A40;
  line-height: 1.8;
}

/* ===== Temperature popups ===== */
.temp-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.temp-popup {
  width: 100%;
  max-height: 70vh;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
}

.tp-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tp-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A3A32;
}

.tp-close {
  font-size: 28rpx;
  color: #B5A69C;
  padding: 8rpx;
  line-height: 1;
}

.tp-scroll {
  max-height: 50vh;
}

.tp-record {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F3E6DD;
}

.tp-record:last-child {
  border-bottom: none;
}

.tp-emoji {
  font-size: 36rpx;
  width: 52rpx;
  text-align: center;
  flex-shrink: 0;
}

.tp-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.tp-line1 {
  font-size: 24rpx;
  color: #5D4A40;
  font-weight: 500;
}

.tp-line2 {
  font-size: 22rpx;
  color: #8B776B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tp-score {
  font-size: 26rpx;
  font-weight: 700;
  color: #E8856A;
  flex-shrink: 0;
}

/* ===== Radar popup extras ===== */
.rp-moods {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F3E6DD;
}

.rp-mood-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.rp-mood-emoji {
  font-size: 22rpx;
}

.rp-mood-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #5D4A40;
}

.rp-mood-pct {
  font-size: 22rpx;
  color: #8B776B;
}

/* ===== Alert (preserved) ===== */
.alert {
  background: linear-gradient(135deg, #FFF1E9 0%, #FFE8DD 100%);
  color: #B86B4E;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-top: 28rpx;
  font-size: 26rpx;
  line-height: 1.6;
  border: 1rpx solid rgba(232, 133, 106, 0.15);
  position: relative;
  padding-left: 60rpx;
}

.alert::before {
  content: '💛';
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
}

/* ===== Empty state (preserved) ===== */
.empty {
  margin-top: 80rpx;
  padding: 50rpx 30rpx;
  text-align: center;
  color: #8B776B;
  font-size: 26rpx;
  line-height: 1.7;
}

.empty button {
  margin-top: 28rpx;
  width: 60%;
  margin-left: auto;
  margin-right: auto;
}

/* ===== Prediction ===== */
.prediction-card {
  padding: 28rpx;
}

.pred-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.pred-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3A32;
}

.pred-trend-badge {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-weight: 600;
}

.pred-trend-up {
  color: #7BC97D;
  background: rgba(123, 201, 125, 0.12);
}

.pred-trend-down {
  color: #E8856A;
  background: rgba(232, 133, 106, 0.10);
}

.pred-trend-stable {
  color: #B5A69C;
  background: rgba(181, 166, 156, 0.10);
}

.pred-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 240rpx;
  padding: 16rpx 0 8rpx;
  margin-bottom: 20rpx;
}

.pred-bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  max-width: 100rpx;
}

.pred-bar-track {
  width: 36rpx;
  height: 160rpx;
  background: #F8F0EA;
  border-radius: 18rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  position: relative;
}

.pred-bar-future {
  background: transparent;
  border: 2rpx dashed #E8856A;
  border-radius: 18rpx;
}

.pred-bar-fill {
  width: 100%;
  border-radius: 18rpx;
  min-height: 8rpx;
  transition: height 0.6s ease;
}

.pred-bar-score {
  font-size: 22rpx;
  font-weight: 600;
  color: #8B776B;
  margin-top: 8rpx;
}

.pred-bar-date {
  font-size: 20rpx;
  color: #B5A69C;
  margin-top: 2rpx;
}

.pred-bar-label {
  font-size: 18rpx;
  color: #E8856A;
  margin-top: 2rpx;
}

.pred-text {
  font-size: 26rpx;
  color: #8B776B;
  line-height: 1.7;
  padding: 16rpx 0;
  border-top: 1rpx solid #F3E6DD;
}

.pred-warning {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF1E9 0%, #FFE8DD 100%);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  border: 1rpx solid rgba(232, 133, 106, 0.15);
}

.pw-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.pw-body {
  flex: 1;
}

.pw-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #B86B4E;
  display: block;
  margin-bottom: 4rpx;
}

.pw-desc {
  font-size: 24rpx;
  color: #C49A88;
  line-height: 1.5;
}

.pw-action {
  font-size: 26rpx;
  color: #E8856A;
  font-weight: 600;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

.prediction-empty {
  padding: 40rpx 30rpx;
  text-align: center;
}

.pe-icon {
  font-size: 56rpx;
  display: block;
  margin-bottom: 12rpx;
}

.pe-text {
  font-size: 26rpx;
  color: #B5A69C;
  line-height: 1.6;
}

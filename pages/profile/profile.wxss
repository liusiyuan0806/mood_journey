.user{display:flex;align-items:center;padding:32rpx;margin-bottom:24rpx}.avatar{width:100rpx;height:100rpx;border-radius:50%;background:#FFE1D4;display:flex;align-items:center;justify-content:center;font-size:40rpx;overflow:hidden}.avatar image{width:100%;height:100%}.user-text{flex:1;margin-left:20rpx}.name{font-size:36rpx;font-weight:700;margin-bottom:9rpx}.chevron{font-size:48rpx;color:#B6AAA6}.logout{background:#FFF;color:#A97869;font-size:28rpx;margin-bottom:25rpx}.stats{padding:30rpx;display:flex;justify-content:space-between;text-align:center}.stats view{display:flex;flex-direction:column;gap:12rpx}.stats text:first-child{font-size:40rpx;font-weight:700;color:#F2785A}.stats text:last-child{font-size:23rpx;color:#968B87}.menu{margin-top:28rpx;padding:0 28rpx}.menu view{padding:29rpx 0;border-bottom:1rpx solid #F2ECE9;font-size:29rpx}.menu view:last-child{border:none}.menu text{float:right;color:#AA9F9B}.menu .delete{color:#CD6760}

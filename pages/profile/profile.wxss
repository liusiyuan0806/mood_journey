/* ===== 我的 · 温暖色调 ===== */

/* 用户信息卡片 */
.user {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF1E6 100%);
}

.user:active {
  opacity: 0.9;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE0D0, #FFD0B8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(232, 133, 106, 0.15);
  flex-shrink: 0;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.user-text {
  flex: 1;
  margin-left: 22rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A3A32;
  margin-bottom: 8rpx;
}

.chevron {
  font-size: 44rpx;
  color: #C9B9AE;
  flex-shrink: 0;
}

/* 登录/退出按钮 */
.logout {
  background: #FFFFFF;
  color: #C47860;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 48rpx;
  line-height: 80rpx;
  border: 1rpx solid #F5E6DB;
  font-weight: 500;
}

.logout::after {
  border: none;
}

/* 统计卡片 */
.stats {
  padding: 32rpx 24rpx;
  display: flex;
  justify-content: space-between;
  text-align: center;
  background: linear-gradient(135deg, #FFFBF7 0%, #FFF1E6 100%);
}

.stats view {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex: 1;
}

.stats view:not(:last-child) {
  border-right: 1rpx solid #F5E6DB;
}

.stats text:first-child {
  font-size: 40rpx;
  font-weight: 800;
  color: #E8856A;
  letter-spacing: -1rpx;
}

.stats text:last-child {
  font-size: 22rpx;
  color: #8B776B;
}

/* 菜单列表 */
.menu {
  margin-top: 28rpx;
  padding: 0 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(200, 130, 90, 0.08);
  border: 1rpx solid rgba(232, 133, 106, 0.06);
}

.menu view {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #F5EBE3;
  font-size: 28rpx;
  color: #4A3A32;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.menu view:last-child {
  border-bottom: none;
}

.menu view:active {
  opacity: 0.7;
}

.menu text {
  color: #C9B9AE;
  font-size: 32rpx;
}

.menu .delete {
  color: #D87060;
}

.menu .delete text {
  color: #E8A898;
}

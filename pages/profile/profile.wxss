/* ===== 我的 · 温暖色调 ===== */

/* 用户信息卡片 */
.user {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF1E6 100%);
}

.user:active {
  opacity: 0.9;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE0D0, #FFD0B8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(232, 133, 106, 0.15);
  flex-shrink: 0;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.user-text {
  flex: 1;
  margin-left: 22rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A3A32;
  margin-bottom: 8rpx;
}

.chevron {
  font-size: 44rpx;
  color: #C9B9AE;
  flex-shrink: 0;
}

/* 登录/退出按钮 */
.logout {
  background: #FFFFFF;
  color: #C47860;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 48rpx;
  line-height: 80rpx;
  border: 1rpx solid #F5E6DB;
  font-weight: 500;
}

.logout::after {
  border: none;
}

/* 统计卡片 */
.stats {
  padding: 32rpx 24rpx;
  display: flex;
  justify-content: space-between;
  text-align: center;
  background: linear-gradient(135deg, #FFFBF7 0%, #FFF1E6 100%);
}

.stats view {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex: 1;
}

.stats view:not(:last-child) {
  border-right: 1rpx solid #F5E6DB;
}

.stats text:first-child {
  font-size: 40rpx;
  font-weight: 800;
  color: #E8856A;
  letter-spacing: -1rpx;
}

.stats text:last-child {
  font-size: 22rpx;
  color: #8B776B;
}

/* 菜单列表 */
.menu {
  margin-top: 28rpx;
  padding: 0 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(200, 130, 90, 0.08);
  border: 1rpx solid rgba(232, 133, 106, 0.06);
}

.menu view {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #F5EBE3;
  font-size: 28rpx;
  color: #4A3A32;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.menu view:last-child {
  border-bottom: none;
}

.menu view:active {
  opacity: 0.7;
}

.menu text {
  color: #C9B9AE;
  font-size: 32rpx;
}

.menu .delete {
  color: #D87060;
}

.menu .delete text {
  color: #E8A898;
}

.watermark-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.watermark-toggle text {
  color: #4A3A32;
  font-size: 28rpx;
}

.watermark-toggle:active {
  opacity: 0.7;
}

/* ===== 节奏建议卡片 ===== */
.rhythm-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-top: 20rpx;
  background: linear-gradient(135deg, #FFF8F2 0%, #FFF0E8 100%);
  border: 1rpx solid rgba(232, 133, 106, 0.15);
}
.rhythm-card:active { opacity: 0.85; }
.rhythm-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.rhythm-info {
  flex: 1;
}
.rhythm-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3A32;
  display: block;
  margin-bottom: 4rpx;
}
.rhythm-desc {
  font-size: 24rpx;
  color: #8B776B;
  line-height: 1.5;
}
.rhythm-action {
  font-size: 24rpx;
  color: #E8856A;
  font-weight: 600;
  flex-shrink: 0;
}

/* ===== 创新功能入口网格 ===== */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}
.feature-item {
  width: calc(50% - 8rpx);
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 24rpx;
}
.feature-item:active {
  transform: scale(0.96);
  opacity: 0.85;
}
.feature-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}
.feature-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A3A32;
  margin-bottom: 4rpx;
}
.feature-sub {
  font-size: 22rpx;
  color: #B5A69C;
}

/* ===== 云同步状态 ===== */
.sync-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  margin-top: 16rpx;
  background: #FFF3E0;
  border-radius: 16rpx;
}
.sync-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}
.sync-text {
  font-size: 24rpx;
  color: #E8856A;
}

/* ===== 分享卡预览弹窗 ===== */
.share-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.share-modal-content {
  width: 100%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.share-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3A32;
  margin-bottom: 24rpx;
}

.share-modal-img {
  width: 100%;
  height: 800rpx;
  border-radius: 12rpx;
  background: #F5EBE3;
  margin-bottom: 32rpx;
}

.share-modal-actions {
  width: 100%;
  display: flex;
  gap: 20rpx;
}

.share-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.share-btn-cancel {
  background: #F5EBE3;
  color: #8B776B;
}

.share-btn-save {
  background: linear-gradient(135deg, #E8856A, #D87060);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(232, 133, 106, 0.3);
}

.share-btn-save:active {
  opacity: 0.9;
}


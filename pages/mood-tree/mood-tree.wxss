/* ===== 情绪树页面 ===== */

.page {
  padding: 24rpx 28rpx 180rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8F2 0%, #FFF0E8 50%, #F3E8DE 100%);
}

/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}
.empty-seed {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  animation: bounce 2s ease-in-out infinite;
}
@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}
.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A3A32;
  margin-bottom: 16rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #B5A69C;
  margin-bottom: 8rpx;
  line-height: 1.8;
}
.empty-state .primary-btn {
  margin-top: 40rpx;
}

/* ===== 树等级头部 ===== */
.tree-header {
  display: flex;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.th-left {
  margin-right: 24rpx;
}
.th-level-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  min-width: 140rpx;
}
.th-level-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.th-level-name {
  font-size: 26rpx;
  font-weight: 700;
}
.th-right {
  flex: 1;
}
.th-stats {
  display: flex;
  gap: 40rpx;
  margin-bottom: 16rpx;
}
.th-stat {
  display: flex;
  flex-direction: column;
}
.th-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A3A32;
}
.th-stat-label {
  font-size: 22rpx;
  color: #B5A69C;
}
.th-progress-track {
  height: 14rpx;
  background: #F3E6DD;
  border-radius: 7rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.th-progress-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.6s ease;
}
.th-progress-text {
  font-size: 22rpx;
  color: #B5A69C;
}
.th-max-text {
  font-size: 24rpx;
  color: #E8856A;
  font-weight: 600;
}

/* ===== 树画布 ===== */
.tree-canvas {
  position: relative;
  width: 100%;
  height: 580rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #E8F6FC 0%, #F5FBFD 45%, #FFF9F5 75%, #F5EDE4 100%);
  box-shadow: 0 8rpx 28rpx rgba(200, 130, 90, 0.10);
}

/* 天空 */
.sky-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 70%;
  background: linear-gradient(180deg, #B8DCEF 0%, #D4EAF5 60%, transparent 100%);
  z-index: 1;
}

/* 首页风格动态云朵：椭圆主体 + 模糊云瓣 */
.cloud {
  position: absolute;
  pointer-events: none;
  animation: cloudFloat linear infinite;
  filter: blur(4rpx);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  z-index: 2;
}
.cloud::before,
.cloud::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: inherit;
  filter: blur(10rpx);
  opacity: 0.8;
}

/* 云朵1 - 左上方大朵 */
.cloud-1 {
  width: 120rpx;
  height: 48rpx;
  top: 64rpx;
  left: 56rpx;
  animation-duration: 28s;
  animation-delay: 0s;
}
.cloud-1::before {
  width: 70rpx; height: 70rpx;
  top: -34rpx; left: 18rpx;
}
.cloud-1::after {
  width: 52rpx; height: 52rpx;
  top: -24rpx; left: 62rpx;
}

/* 云朵2 - 右上方小朵 */
.cloud-2 {
  width: 84rpx;
  height: 34rpx;
  top: 108rpx;
  right: 64rpx;
  animation-duration: 22s;
  animation-delay: 5s;
}
.cloud-2::before {
  width: 48rpx; height: 48rpx;
  top: -24rpx; left: 12rpx;
}
.cloud-2::after {
  width: 36rpx; height: 36rpx;
  top: -16rpx; left: 44rpx;
}

@keyframes cloudFloat {
  0%   { transform: translateX(0) translateY(0); }
  25%  { transform: translateX(12rpx) translateY(-4rpx); }
  50%  { transform: translateX(20rpx) translateY(2rpx); }
  75%  { transform: translateX(8rpx) translateY(-2rpx); }
  100% { transform: translateX(0) translateY(0); }
}

/* 太阳 + 橙色光晕 */
.sun {
  position: absolute;
  top: 40rpx;
  right: 66rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.sun-core {
  position: absolute;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #FFF8E1 0%, #FFE082 45%, #FFB74D 100%);
  box-shadow: 0 0 16rpx rgba(255, 183, 77, 0.8);
  animation: sunPulse 4s ease-in-out infinite;
  z-index: 2;
}
.sun-halo {
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 183, 77, 0.55) 0%, rgba(255, 167, 38, 0.25) 50%, transparent 70%);
  animation: haloPulse 4s ease-in-out infinite;
  z-index: 1;
}
@keyframes sunPulse {
  0%, 100% { transform: scale(1); opacity: 0.95; }
  50% { transform: scale(1.08); opacity: 1; }
}
@keyframes haloPulse {
  0%, 100% { transform: scale(1); opacity: 0.85; }
  50% { transform: scale(1.15); opacity: 1; }
}

/* 情绪树背景图（image 组件） */
.tree-bg {
  position: absolute;
  left: 50%;
  bottom: 80rpx;
  transform: translateX(-50%);
  width: 480rpx;
  height: 480rpx;
  pointer-events: none;
  z-index: 5;
}

/* 地面 */
.ground {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(180deg, transparent 0%, #D4C4A8 20%, #C4B098 100%);
  z-index: 3;
}
.grass {
  position: absolute;
  bottom: 100rpx;
  left: 0;
  right: 0;
  height: 30rpx;
  background: linear-gradient(180deg, #8FBC5A 0%, #7BAB4A 100%);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  transform: scaleY(0.6);
}

/* 心情果实 */
.fruits {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
  pointer-events: none;
}
.fruits .fruit {
  pointer-events: auto;
}
.fruit {
  position: absolute;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.15), inset 0 -2rpx 4rpx rgba(0,0,0,0.1);
  animation: fruitAppear 0.5s ease-out backwards;
  transition: transform 0.2s ease;
}
.fruit:active {
  transform: scale(1.3);
}
@keyframes fruitAppear {
  0% { transform: scale(0); opacity: 0; }
  60% { transform: scale(1.15); }
  100% { transform: scale(1); opacity: 1; }
}
.fruit-glow {
  box-shadow: 0 4rpx 12rpx rgba(255,255,255,0.4), 0 2rpx 8rpx rgba(0,0,0,0.15), inset 0 -2rpx 4rpx rgba(255,255,255,0.3);
}
.fruit-emoji {
  line-height: 1;
}

/* 装饰花 */
.flower {
  position: absolute;
  font-size: 28rpx;
  animation: flowerSway 3s ease-in-out infinite;
}
.flower-1 { bottom: 90rpx; left: 60rpx; animation-delay: 0s; }
.flower-2 { bottom: 85rpx; left: 120rpx; animation-delay: 0.5s; }
.flower-3 { bottom: 88rpx; right: 80rpx; animation-delay: 1s; }
@keyframes flowerSway {
  0%, 100% { transform: rotate(-5deg); }
  50% { transform: rotate(5deg); }
}

/* ===== 图例 ===== */
.legend {
  padding: 28rpx;
  margin-top: 20rpx;
}
.legend-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3A32;
  margin-bottom: 20rpx;
}
.legend-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}
.legend-emoji {
  font-size: 28rpx;
}
.legend-name {
  font-size: 24rpx;
  color: #4A3A32;
}
.legend-count {
  font-size: 22rpx;
  color: #B5A69C;
}
.legend-hint {
  font-size: 22rpx;
  color: #B5A69C;
  margin-top: 8rpx;
}

/* ===== 操作 ===== */
.tree-actions {
  margin-top: 30rpx;
  text-align: center;
}
.tree-actions .primary-btn {
  margin-bottom: 20rpx;
}
.action-secondary {
  font-size: 26rpx;
  color: #E8856A;
  padding: 16rpx;
}

/* ===== 果实详情弹层 ===== */
.fruit-detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.fruit-detail {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}
@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
.fd-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  position: relative;
}
.fd-emoji-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}
.fd-emoji {
  font-size: 40rpx;
}
.fd-info {
  flex: 1;
}
.fd-mood {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A3A32;
  display: block;
}
.fd-score {
  font-size: 24rpx;
  color: #B5A69C;
  margin-top: 4rpx;
}
.fd-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  font-size: 32rpx;
  color: #B5A69C;
  padding: 8rpx;
}
.fd-body {
  padding: 30rpx;
}
.fd-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.fd-date, .fd-time, .fd-weather {
  font-size: 24rpx;
  color: #8B776B;
  background: #FFF1E6;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}
.fd-note {
  background: #FFF8F2;
  border-radius: 16rpx;
  padding: 24rpx;
}
.fd-note-label {
  font-size: 22rpx;
  color: #B5A69C;
  display: block;
  margin-bottom: 8rpx;
}
.fd-note-text {
  font-size: 28rpx;
  color: #4A3A32;
  line-height: 1.8;
  font-style: italic;
}
.fd-no-note {
  text-align: center;
  padding: 30rpx;
  color: #B5A69C;
  font-size: 26rpx;
}

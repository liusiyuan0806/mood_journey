/* ===== 情绪树页面 ===== */

.page {
  padding: 24rpx 28rpx 180rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8F2 0%, #FFF0E8 50%, #F3E8DE 100%);
}

/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}
.empty-seed {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  animation: bounce 2s ease-in-out infinite;
}
@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}
.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A3A32;
  margin-bottom: 16rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #B5A69C;
  margin-bottom: 8rpx;
  line-height: 1.8;
}
.empty-state .primary-btn {
  margin-top: 40rpx;
}

/* ===== 树等级头部 ===== */
.tree-header {
  display: flex;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.th-left {
  margin-right: 24rpx;
}
.th-level-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  min-width: 140rpx;
}
.th-level-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.th-level-name {
  font-size: 26rpx;
  font-weight: 700;
}
.th-right {
  flex: 1;
}
.th-stats {
  display: flex;
  gap: 40rpx;
  margin-bottom: 16rpx;
}
.th-stat {
  display: flex;
  flex-direction: column;
}
.th-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A3A32;
}
.th-stat-label {
  font-size: 22rpx;
  color: #B5A69C;
}
.th-progress-track {
  height: 14rpx;
  background: #F3E6DD;
  border-radius: 7rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.th-progress-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.6s ease;
}
.th-progress-text {
  font-size: 22rpx;
  color: #B5A69C;
}
.th-max-text {
  font-size: 24rpx;
  color: #E8856A;
  font-weight: 600;
}

/* ===== 树画布 ===== */
.tree-canvas {
  position: relative;
  width: 100%;
  height: 580rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #C8E5F0 0%, #E8F4F8 40%, #FFF8F0 70%, #F0E8D8 100%);
  box-shadow: 0 8rpx 28rpx rgba(200, 130, 90, 0.10);
}

/* 天空 */
.sky-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 70%;
  background: linear-gradient(180deg, #B8DCEF 0%, #D4EAF5 60%, transparent 100%);
}

/* 云 */
.cloud {
  position: absolute;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50rpx;
  animation: cloudDrift 20s linear infinite;
}
.cloud-a {
  top: 60rpx;
  left: 40rpx;
  width: 100rpx;
  height: 30rpx;
  animation-duration: 25s;
}
.cloud-b {
  top: 100rpx;
  right: 60rpx;
  width: 80rpx;
  height: 24rpx;
  animation-duration: 30s;
  animation-direction: reverse;
}
@keyframes cloudDrift {
  0% { transform: translateX(0); }
  50% { transform: translateX(30rpx); }
  100% { transform: translateX(0); }
}

/* 太阳 */
.sun {
  position: absolute;
  top: 40rpx;
  right: 60rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #FFE19A 30%, #FFD060 70%, transparent 100%);
  box-shadow: 0 0 40rpx rgba(255, 209, 102, 0.5);
  animation: sunPulse 4s ease-in-out infinite;
}
@keyframes sunPulse {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.08); opacity: 1; }
}

/* 地面 */
.ground {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(180deg, transparent 0%, #D4C4A8 20%, #C4B098 100%);
}
.grass {
  position: absolute;
  bottom: 100rpx;
  left: 0;
  right: 0;
  height: 30rpx;
  background: linear-gradient(180deg, #8FBC5A 0%, #7BAB4A 100%);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  transform: scaleY(0.6);
}

/* 树干 */
.trunk {
  position: absolute;
  bottom: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  background: linear-gradient(90deg, #8B6F47 0%, #A0825A 50%, #8B6F47 100%);
  border-radius: 4rpx;
  min-height: 40rpx;
  transition: height 0.8s ease;
  box-shadow: 2rpx 0 4rpx rgba(0,0,0,0.1);
}

/* 树枝 (使用伪元素方式, 通过 view 模拟) */
.branches {
  position: absolute;
  bottom: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 300rpx;
  pointer-events: none;
}
.branch {
  position: absolute;
  background: linear-gradient(90deg, #8B6F47, #A0825A);
  border-radius: 4rpx;
  transform-origin: center bottom;
}

/* 树叶 */
.leaves {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.leaf {
  position: absolute;
  background: radial-gradient(circle, #8FBC5A 40%, #7BAB4A 80%);
  border-radius: 50% 0 50% 50%;
  opacity: 0.85;
  animation: leafGrow 0.6s ease-out backwards;
}
@keyframes leafGrow {
  0% { transform: scale(0) rotate(0deg); opacity: 0; }
  100% { opacity: 0.85; }
}

/* 心情果实 */
.fruits {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.fruit {
  position: absolute;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.15), inset 0 -2rpx 4rpx rgba(0,0,0,0.1);
  animation: fruitAppear 0.5s ease-out backwards;
  transition: transform 0.2s ease;
}
.fruit:active {
  transform: scale(1.3);
}
@keyframes fruitAppear {
  0% { transform: scale(0); opacity: 0; }
  60% { transform: scale(1.15); }
  100% { transform: scale(1); opacity: 1; }
}
.fruit-glow {
  box-shadow: 0 4rpx 12rpx rgba(255,255,255,0.4), 0 2rpx 8rpx rgba(0,0,0,0.15), inset 0 -2rpx 4rpx rgba(255,255,255,0.3);
}
.fruit-emoji {
  line-height: 1;
}

/* 装饰花 */
.flower {
  position: absolute;
  font-size: 28rpx;
  animation: flowerSway 3s ease-in-out infinite;
}
.flower-1 { bottom: 90rpx; left: 60rpx; animation-delay: 0s; }
.flower-2 { bottom: 85rpx; left: 120rpx; animation-delay: 0.5s; }
.flower-3 { bottom: 88rpx; right: 80rpx; animation-delay: 1s; }
@keyframes flowerSway {
  0%, 100% { transform: rotate(-5deg); }
  50% { transform: rotate(5deg); }
}

/* ===== 图例 ===== */
.legend {
  padding: 28rpx;
  margin-top: 20rpx;
}
.legend-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3A32;
  margin-bottom: 20rpx;
}
.legend-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}
.legend-emoji {
  font-size: 28rpx;
}
.legend-name {
  font-size: 24rpx;
  color: #4A3A32;
}
.legend-count {
  font-size: 22rpx;
  color: #B5A69C;
}
.legend-hint {
  font-size: 22rpx;
  color: #B5A69C;
  margin-top: 8rpx;
}

/* ===== 操作 ===== */
.tree-actions {
  margin-top: 30rpx;
  text-align: center;
}
.tree-actions .primary-btn {
  margin-bottom: 20rpx;
}
.action-secondary {
  font-size: 26rpx;
  color: #E8856A;
  padding: 16rpx;
}

/* ===== 果实详情弹层 ===== */
.fruit-detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.fruit-detail {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}
@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
.fd-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  position: relative;
}
.fd-emoji-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}
.fd-emoji {
  font-size: 40rpx;
}
.fd-info {
  flex: 1;
}
.fd-mood {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A3A32;
  display: block;
}
.fd-score {
  font-size: 24rpx;
  color: #B5A69C;
  margin-top: 4rpx;
}
.fd-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  font-size: 32rpx;
  color: #B5A69C;
  padding: 8rpx;
}
.fd-body {
  padding: 30rpx;
}
.fd-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.fd-date, .fd-time, .fd-weather {
  font-size: 24rpx;
  color: #8B776B;
  background: #FFF1E6;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}
.fd-note {
  background: #FFF8F2;
  border-radius: 16rpx;
  padding: 24rpx;
}
.fd-note-label {
  font-size: 22rpx;
  color: #B5A69C;
  display: block;
  margin-bottom: 8rpx;
}
.fd-note-text {
  font-size: 28rpx;
  color: #4A3A32;
  line-height: 1.8;
  font-style: italic;
}
.fd-no-note {
  text-align: center;
  padding: 30rpx;
  color: #B5A69C;
  font-size: 26rpx;
}

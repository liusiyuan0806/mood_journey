/* ===== 我的收藏 · 温暖色调 ===== */
.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 60rpx;
  background: linear-gradient(180deg, #FFFBF7 0%, #FFF4EA 100%);
  box-sizing: border-box;
}

/* 顶部标题区 */
.header {
  padding: 18rpx 8rpx 28rpx;
}
.header-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.title {
  font-size: 44rpx;
  font-weight: 800;
  color: #4A3A32;
  letter-spacing: 1rpx;
}
.count {
  font-size: 24rpx;
  color: #B5A69C;
}
.subtitle {
  display: block;
  font-size: 25rpx;
  color: #8B776B;
  margin-top: 8rpx;
  font-weight: 400;
}

/* 卡片基础 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 22rpx rgba(200, 130, 90, 0.08);
  border: 1rpx solid rgba(232, 133, 106, 0.06);
}

/* 空状态 */
.empty {
  margin-top: 80rpx;
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.empty-icon {
  font-size: 90rpx;
  margin-bottom: 24rpx;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #6B5A50;
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 25rpx;
  color: #B5A69C;
  line-height: 1.6;
  max-width: 480rpx;
}

/* 列表 */
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.item {
  padding: 28rpx 28rpx 20rpx;
  position: relative;
  transition: transform 0.2s;
}
.item::before {
  content: '"';
  position: absolute;
  top: 10rpx;
  left: 18rpx;
  font-size: 56rpx;
  color: rgba(232, 133, 106, 0.12);
  font-family: Georgia, serif;
  line-height: 1;
  pointer-events: none;
}
.item-text {
  font-size: 28rpx;
  color: #4A3A32;
  line-height: 1.75;
  font-style: italic;
  letter-spacing: 0.5rpx;
  padding: 6rpx 30rpx 20rpx;
}
.item-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #F5EBE3;
  padding-top: 16rpx;
}
.item-time {
  font-size: 22rpx;
  color: #B5A69C;
}
.item-actions {
  display: flex;
  gap: 14rpx;
}
.item-btn {
  padding: 8rpx 22rpx;
  font-size: 23rpx;
  color: #8B776B;
  background: #F7EFE8;
  border-radius: 28rpx;
  transition: all 0.2s;
}
.item-btn.danger {
  color: #C47860;
  background: #FBEBE3;
}
.item-btn-hover {
  transform: scale(0.94);
  background: #F0B27A !important;
  color: #FFFFFF !important;
}

/* 底部清空按钮 */
.footer {
  margin-top: 16rpx;
  text-align: center;
}
.clear-btn {
  display: inline-block;
  font-size: 25rpx;
  color: #B5A69C;
  padding: 14rpx 36rpx;
  border-radius: 32rpx;
  background: transparent;
  border: 1rpx solid #E8D8C8;
  transition: all 0.2s;
}
.clear-btn-hover {
  color: #C47860;
  border-color: #E8B0A0;
  background: #FBEBE3;
}

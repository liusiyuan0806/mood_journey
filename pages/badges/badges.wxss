/* ===== 徽章成就页面 ===== */

.page {
  padding: 24rpx 28rpx 180rpx;
  min-height: 100vh;
}

/* ===== 头部统计 ===== */
.badges-header {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  margin-bottom: 10rpx;
}
.bh-circle {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
}
.bh-circle-bg {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF1E6 0%, #FFE0CC 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #E8856A33;
  box-shadow: 0 4rpx 16rpx rgba(232, 133, 106, 0.15);
}
.bh-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #E8856A;
  line-height: 1.1;
}
.bh-total {
  font-size: 24rpx;
  color: #B5A69C;
}
.bh-label {
  font-size: 22rpx;
  color: #B5A69C;
  margin-top: 8rpx;
}
.bh-progress-area {
  flex: 1;
}
.bh-progress-track {
  height: 20rpx;
  background: #F3E6DD;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.bh-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #F09070 0%, #E8856A 100%);
  border-radius: 10rpx;
  transition: width 0.8s ease;
}
.bh-progress-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #4A3A32;
  display: block;
  margin-bottom: 4rpx;
}
.bh-hint {
  font-size: 22rpx;
  color: #B5A69C;
}

/* ===== 徽章网格 ===== */
.badges-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 4rpx 0;
}
.badge-card {
  width: calc(33.33% - 14rpx);
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(200, 130, 90, 0.06);
  border: 1rpx solid rgba(232, 133, 106, 0.06);
  transition: transform 0.2s ease;
}
.badge-card:active {
  transform: scale(0.96);
}
.badge-locked {
  opacity: 0.55;
}
.badge-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  position: relative;
  overflow: hidden;
  background: #F3E6DD;
}
.badge-icon {
  font-size: 44rpx;
}
.badge-icon-locked {
  font-size: 36rpx;
  filter: grayscale(1);
}
.badge-shine {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.4) 50%, transparent 60%);
  animation: shine 3s ease-in-out infinite;
}
@keyframes shine {
  0%, 100% { transform: translateX(-30%) translateY(-30%); }
  50% { transform: translateX(30%) translateY(30%); }
}
.badge-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #4A3A32;
  margin-bottom: 4rpx;
}
.badge-name-locked {
  color: #B5A69C;
}
.badge-desc {
  font-size: 20rpx;
  color: #B5A69C;
  text-align: center;
  line-height: 1.4;
  margin-bottom: 8rpx;
}
.badge-status {
  background: #E8856A;
  border-radius: 16rpx;
  padding: 4rpx 12rpx;
}
.badge-status-text {
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== 操作 ===== */
.badges-actions {
  margin-top: 40rpx;
  text-align: center;
}

/* ===== 解锁动画 ===== */
.unlock-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}
.unlock-content {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 50rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  animation: unlockPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes unlockPop {
  0% { transform: scale(0.3); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* 撒花 */
.confetti-area {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}
.confetti {
  position: absolute;
  font-size: 36rpx;
  animation: confettiFall 2s ease-out forwards;
}
.c1 { left: 10%; animation-delay: 0s; }
.c2 { left: 25%; animation-delay: 0.1s; }
.c3 { left: 40%; animation-delay: 0.2s; }
.c4 { left: 55%; animation-delay: 0.05s; }
.c5 { left: 70%; animation-delay: 0.15s; }
.c6 { left: 85%; animation-delay: 0.25s; }
.c7 { left: 20%; animation-delay: 0.3s; }
.c8 { left: 75%; animation-delay: 0.35s; }
@keyframes confettiFall {
  0% { top: -40rpx; opacity: 1; transform: rotate(0deg); }
  100% { top: 400rpx; opacity: 0; transform: rotate(360deg); }
}

.unlock-badge-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid;
  margin-bottom: 24rpx;
  animation: badgePulse 1.5s ease-in-out infinite;
}
@keyframes badgePulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(232, 133, 106, 0.3); }
  50% { transform: scale(1.05); box-shadow: 0 0 0 20rpx rgba(232, 133, 106, 0); }
}
.unlock-badge-icon {
  font-size: 72rpx;
}
.unlock-title {
  font-size: 30rpx;
  color: #E8856A;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.unlock-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A3A32;
  margin-bottom: 12rpx;
}
.unlock-desc {
  font-size: 26rpx;
  color: #8B776B;
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.6;
}
.unlock-btn {
  background: linear-gradient(135deg, #F09070 0%, #E8856A 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 60rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 20rpx rgba(232, 133, 106, 0.25);
}
.unlock-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

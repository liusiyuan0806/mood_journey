/* ===== 呼吸练习页面 ===== */

.breathing-page {
  padding: 28rpx 30rpx 180rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8F2 0%, #F0F4F8 100%);
  transition: background 0.8s ease;
}
.breathing-page.running {
  background: linear-gradient(180deg, #2C3E50 0%, #1A1A2E 50%, #16213E 100%);
}

/* ===== 介绍 ===== */
.breathing-intro {
  text-align: center;
  padding: 40rpx 0 30rpx;
}
.bi-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  animation: breathe 4s ease-in-out infinite;
}
@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}
.bi-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A3A32;
  margin-bottom: 8rpx;
}
.bi-desc {
  font-size: 26rpx;
  color: #B5A69C;
}

/* ===== 练习列表 ===== */
.exercise-list {
  margin-bottom: 30rpx;
}
.exercise-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  border: 3rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(200, 130, 90, 0.06);
  transition: all 0.3s ease;
}
.exercise-card.selected {
  border-width: 3rpx;
}
.ec-left {
  display: flex;
  align-items: center;
  flex: 1;
}
.ec-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.ec-icon {
  font-size: 40rpx;
}
.ec-info {
  flex: 1;
}
.ec-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3A32;
  display: block;
  margin-bottom: 4rpx;
}
.ec-subtitle {
  font-size: 22rpx;
  color: #B5A69C;
  display: block;
  margin-bottom: 6rpx;
}
.ec-desc {
  font-size: 22rpx;
  color: #8B776B;
}
.ec-right {
  text-align: right;
  flex-shrink: 0;
}
.ec-rounds {
  font-size: 28rpx;
  font-weight: 700;
  color: #E8856A;
  display: block;
}
.ec-duration {
  font-size: 20rpx;
  color: #B5A69C;
}

/* ===== 开始区域 ===== */
.start-area {
  text-align: center;
  margin: 30rpx 0;
}
.breathing-start-btn {
  width: 80%;
  margin-bottom: 12rpx;
}
.start-hint {
  font-size: 22rpx;
  color: #B5A69C;
}

/* ===== 放松小贴士 ===== */
.tips-list {
  margin-bottom: 20rpx;
}
.tip-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 12rpx;
}
.tip-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.tip-info {
  flex: 1;
}
.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A3A32;
  display: block;
  margin-bottom: 4rpx;
}
.tip-desc {
  font-size: 24rpx;
  color: #8B776B;
  line-height: 1.5;
}

/* ===== 练习进行中 ===== */
.running-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 10rpx;
}
.rh-round {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}
.rh-round-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.rh-round-total {
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
}
.rh-round-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-left: 8rpx;
}
.rh-exercise-name {
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
}
.rh-stop {
  font-size: 26rpx;
  color: #E8856A;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(232, 133, 106, 0.15);
}

/* 呼吸圆环 */
.breathing-arena {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 600rpx;
  padding: 40rpx 0;
}
.breath-circle-wrap {
  position: relative;
  width: 400rpx;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.breath-ring {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid;
}
.outer-ring {
  width: 400rpx;
  height: 400rpx;
}
.middle-ring {
  width: 320rpx;
  height: 320rpx;
}
.breath-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 4s ease-in-out, opacity 4s ease-in-out;
  box-shadow: 0 0 60rpx rgba(232, 133, 106, 0.3);
}
/* inhale - scale up */
.breath-circle.phase-inhale {
  transform: scale(1.6);
  opacity: 0.9;
  transition: transform 4s ease-in, opacity 4s ease-in;
}
/* hold - maintain */
.breath-circle.phase-hold {
  transform: scale(1.6);
  opacity: 0.7;
  transition: all 0.3s ease;
}
/* exhale - scale down */
.breath-circle.phase-exhale {
  transform: scale(0.6);
  opacity: 0.4;
  transition: transform 4s ease-out, opacity 4s ease-out;
}
.breath-countdown {
  font-size: 64rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

/* 指令文字 */
.breath-instruction {
  margin-top: 60rpx;
  text-align: center;
}
.bi-phase-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
}
.bi-phase-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
}

/* 暂停按钮 */
.pause-btn {
  margin-top: 40rpx;
  padding: 16rpx 48rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 40rpx;
  border: 1rpx solid rgba(255,255,255,0.2);
}
.pause-btn text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

/* 底部进度条 */
.running-progress {
  margin-top: 20rpx;
  padding: 0 20rpx;
}
.rp-track {
  height: 8rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.rp-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 1s linear;
}
.rp-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  text-align: center;
  display: block;
}

/* ===== 完成页面 ===== */
.completion-view {
  padding: 60rpx 0;
}
.comp-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8FBC5A 0%, #7BAB4A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(143, 188, 90, 0.3);
  animation: compBounce 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes compBounce {
  0% { transform: scale(0); }
  100% { transform: scale(1); }
}
.comp-emoji {
  font-size: 72rpx;
}
.comp-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A3A32;
  text-align: center;
  margin-bottom: 12rpx;
}
.comp-message {
  font-size: 28rpx;
  color: #8B776B;
  text-align: center;
  line-height: 1.8;
  padding: 0 40rpx;
  margin-bottom: 30rpx;
}
.comp-divider {
  height: 1rpx;
  background: #F3E6DD;
  margin: 30rpx 0;
}
.comp-section-title {
  margin-bottom: 16rpx;
}
.comp-actions {
  margin-top: 40rpx;
  text-align: center;
}
.comp-actions .primary-btn {
  margin-bottom: 16rpx;
}
.comp-secondary {
  font-size: 26rpx;
  color: #E8856A;
  padding: 16rpx;
}

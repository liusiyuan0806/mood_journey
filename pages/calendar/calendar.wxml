<view class="page">
  <view class="overview card">
    <view>
      <text class="big">{{streak}}</text>
      <text> 天连续打卡</text>
    </view>
    <!-- 拆分为 block，让 wx:if 和 wx:else 成为相邻兄弟 -->
    <block wx:if="{{summary.length}}">
      <view class="summary" wx:for="{{summary}}" wx:key="name">
        <text>{{item.name}} {{item.count}}次</text>
        <view class="bar">
          <view style="width:{{item.width}}"></view>
        </view>
      </view>
    </block>
    <view wx:else class="muted">本月还没有记录</view>
  </view>

  <view class="switch">
    <text bindtap="prev">‹</text>
    <text>{{year}} 年 {{month}} 月</text>
    <text bindtap="next">›</text>
  </view>

  <view class="week">
    <text wx:for="日一二三四五六" wx:key="*this">{{item}}</text>
  </view>

  <view class="calendar">
    <view wx:for="{{days}}" wx:key="date" class="day {{item.empty?'empty':''}}"bindtap="choose" data-date="{{item.date}}" data-record="{{item.record}}">
      <view wx:if="{{!item.empty}}" class="date" style="background:{{item.color||'transparent'}}">
        {{item.day}}
      </view>
    </view>
  </view>

  <view wx:if="{{selected}}" class="mask" bindtap="close">
    <view class="sheet" catchtap="">
      <view class="sheet-mood">{{selected.emoji}} {{selected.mood}}</view>
      <view class="muted">{{selected.date}} · {{selected.weather || '未记录天气'}}</view>
      <view class="note">{{selected.note || '没有留下文字备注'}}</view>
      <view class="actions">
        <button bindtap="edit">编辑</button>
        <button class="danger" bindtap="remove">删除</button>
      </view>
    </view>
  </view>
</view>

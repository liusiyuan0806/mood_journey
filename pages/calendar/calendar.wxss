/* ===== 情绪日历 · 温暖色调 ===== */

/* 月度概览卡片 */
.overview {
  padding: 32rpx 30rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF1E6 100%);
}

.big {
  font-size: 56rpx;
  font-weight: 800;
  color: #E8856A;
  letter-spacing: -1rpx;
}

.overview > view:first-child {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.overview > view:first-child text:last-child {
  font-size: 26rpx;
  color: #8B776B;
  font-weight: 500;
}

.summary {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #6B5A50;
}

.bar {
  height: 12rpx;
  background: #F5E6DB;
  border-radius: 12rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

.bar view {
  height: 100%;
  background: linear-gradient(90deg, #F0B27A, #E8856A);
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

/* 月份切换 */
.switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3A32;
  margin: 36rpx 10rpx 24rpx;
}

.switch text:first-child,
.switch text:last-child {
  font-size: 52rpx;
  color: #E8856A;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF1E6;
  border-radius: 50%;
  line-height: 1;
}

.switch text:first-child:active,
.switch text:last-child:active {
  background: #FFE0CC;
  transform: scale(0.9);
}

/* 星期表头 */
.week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  color: #B5A69C;
  font-size: 24rpx;
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 日历网格 */
.calendar {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  row-gap: 10rpx;
}

.day {
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.date {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 50%;
  font-size: 26rpx;
  color: #5D4A40;
  font-weight: 500;
  transition: all 0.2s ease;
}

.date:active {
  transform: scale(0.9);
}

.day.empty .date {
  color: transparent;
}

/* 底部弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(74, 58, 50, 0.35);
  z-index: 10;
  backdrop-filter: blur(2px);
}

.sheet {
  position: absolute;
  bottom: 0;
  width: 100%;
  box-sizing: border-box;
  background: #FFF8F2;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 60rpx;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.sheet-mood {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A3A32;
  margin-bottom: 8rpx;
}

.sheet .muted {
  font-size: 24rpx;
  color: #B5A69C;
}

.note {
  margin: 24rpx 0 32rpx;
  font-size: 28rpx;
  color: #6B5A50;
  line-height: 1.7;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #F5EBE3;
}

.actions {
  display: flex;
  gap: 20rpx;
}

.actions button {
  flex: 1;
  font-size: 28rpx;
  border-radius: 40rpx;
  line-height: 80rpx;
}

.actions button:first-child {
  background: #FFF1E6;
  color: #E8856A;
}

.actions button::after {
  border: none;
}

.danger {
  color: #D87060 !important;
  background: #FFE8E3 !important;
}

/* 新增记录按钮 */
.add-btn {
  margin-top: 40rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #F09070 0%, #E8856A 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 6rpx 16rpx rgba(232, 133, 106, 0.25);
  letter-spacing: 2rpx;
}

.add-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

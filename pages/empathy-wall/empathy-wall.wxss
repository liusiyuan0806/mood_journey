/* ===== 共情墙页面 ===== */

.page {
  padding: 28rpx 30rpx 0;
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8F2 0%, #FFF1E6 100%);
}

/* ===== 头部 ===== */
.wall-header {
  background: linear-gradient(135deg, #FFE8DD 0%, #FFF8F2 60%, #FFF1E6 100%);
  border-radius: 28rpx;
  padding: 36rpx 30rpx 28rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}
.wall-header::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 160rpx;
  height: 160rpx;
  background: radial-gradient(circle, rgba(232, 133, 106, 0.12) 0%, transparent 70%);
  border-radius: 50%;
}
.wh-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}
.wh-icon {
  font-size: 38rpx;
}
.wh-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #4A3A32;
  letter-spacing: 1rpx;
}
.wh-desc {
  font-size: 24rpx;
  color: #8B776B;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.wh-stats {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.ws-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.ws-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #E8856A;
  line-height: 1;
}
.ws-label {
  font-size: 22rpx;
  color: #B5A69C;
}
.ws-divider {
  width: 1rpx;
  height: 48rpx;
  background: #F5E6DB;
}

/* ===== 筛选栏 ===== */
.filter-bar {
  margin-bottom: 24rpx;
  white-space: nowrap;
}
.filter-list {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 0;
}
.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(200, 130, 90, 0.05);
  transition: all 0.2s ease;
  flex-shrink: 0;
}
.filter-chip.active {
  border-color: #E8856A;
  background: rgba(232, 133, 106, 0.08);
}
.fc-emoji {
  font-size: 28rpx;
}
.fc-label {
  font-size: 24rpx;
  color: #4A3A32;
  font-weight: 500;
}
.filter-chip.active .fc-label {
  color: #E8856A;
  font-weight: 700;
}

/* ===== 帖子列表 ===== */
.post-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.post-card {
  padding: 28rpx 26rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(200, 130, 90, 0.06);
}

/* 帖子头部 */
.pc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.pc-mood-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}
.pc-mood-emoji {
  font-size: 32rpx;
}
.pc-mood-name {
  font-size: 26rpx;
  font-weight: 600;
}
.pc-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}
.pc-author {
  font-size: 24rpx;
  color: #8B776B;
  font-weight: 500;
}
.pc-time {
  font-size: 20rpx;
  color: #C5B5A8;
}

/* 帖子内容 */
.pc-content {
  font-size: 28rpx;
  color: #4A3A32;
  line-height: 1.8;
  margin-bottom: 24rpx;
  letter-spacing: 0.5rpx;
}

/* 帖子底部 */
.pc-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5EBE3;
}
.pc-hug-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  background: #FFF8F2;
  border-radius: 28rpx;
  transition: all 0.2s ease;
}
.pc-hug-btn:active {
  transform: scale(0.94);
}
.pc-hug-btn.hugged {
  background: rgba(232, 133, 106, 0.12);
}
.pc-hug-icon {
  font-size: 28rpx;
}
.pc-hug-count {
  font-size: 24rpx;
  color: #8B776B;
  font-weight: 600;
}
.pc-hug-btn.hugged .pc-hug-count {
  color: #E8856A;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A3A32;
  margin-bottom: 8rpx;
}
.empty-hint {
  font-size: 24rpx;
  color: #B5A69C;
}

/* ===== 发布按钮 ===== */
.fab-btn {
  position: fixed;
  right: 36rpx;
  bottom: 150rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 36rpx;
  background: linear-gradient(135deg, #E8856A 0%, #F0B27A 100%);
  border-radius: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(232, 133, 106, 0.35);
  z-index: 100;
  transition: transform 0.2s ease;
}
.fab-btn:active {
  transform: scale(0.94);
}
.fab-icon {
  font-size: 32rpx;
}
.fab-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* ===== 发布弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 36rpx 30rpx calc(36rpx + env(safe-area-inset-bottom));
  animation: modalSlideUp 0.3s ease;
}
@keyframes modalSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A3A32;
}
.modal-close {
  font-size: 36rpx;
  color: #C5B5A8;
  padding: 8rpx;
}

/* 弹窗分区 */
.modal-section {
  margin-bottom: 28rpx;
}
.ms-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #4A3A32;
  margin-bottom: 16rpx;
}

/* 心情选择器 */
.mood-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.mp-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 20rpx;
  background: #FFF8F2;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
  min-width: 100rpx;
}
.mp-item:active {
  transform: scale(0.94);
}
.mp-item.selected {
  border-width: 2rpx;
}
.mp-emoji {
  font-size: 36rpx;
}
.mp-name {
  font-size: 22rpx;
  color: #8B776B;
}
.mp-item.selected .mp-name {
  font-weight: 600;
  color: #4A3A32;
}

/* 文本输入 */
.modal-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx;
  background: #FFF8F2;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #4A3A32;
  line-height: 1.7;
  box-sizing: border-box;
}
.textarea-placeholder {
  color: #C5B5A8;
  font-size: 26rpx;
}
.textarea-count {
  text-align: right;
  font-size: 22rpx;
  color: #C5B5A8;
  margin-top: 8rpx;
}

/* 提交按钮 */
.modal-submit {
  width: 100%;
  margin-top: 8rpx;
}

/* 隐私提示 */
.modal-hint {
  text-align: center;
  margin-top: 16rpx;
}
.modal-hint text {
  font-size: 22rpx;
  color: #C5B5A8;
}

/* ===== 记录心情 · 温暖色调 ===== */

/* 表单区块 */
.section {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #8B776B;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.picker-box {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #4A3A32;
  box-shadow: 0 4rpx 12rpx rgba(200, 130, 90, 0.06);
  border: 1rpx solid rgba(232, 133, 106, 0.08);
}

/* ========== 天气快照卡片 ========== */
.weather-snapshot-card {
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  background: linear-gradient(135deg, #5B6EE1 0%, #7B68D4 100%);
}

/* 天气背景渐变 — WXSS 预定义，避免 style 绑定不生效 */
.weather-bg-sunny {
  background: linear-gradient(135deg, #5B6EE1 0%, #7B68D4 100%) !important;
}
.weather-bg-cloudy {
  background: linear-gradient(135deg, #5B8BD4 0%, #4A7FC0 100%) !important;
}
.weather-bg-rainy {
  background: linear-gradient(135deg, #4A5568 0%, #3A4A5C 100%) !important;
}
.weather-bg-snowy {
  background: linear-gradient(135deg, #8BA4BE 0%, #7A94AE 100%) !important;
}
.weather-bg-foggy {
  background: linear-gradient(135deg, #6B7B8D 0%, #5A6A7C 100%) !important;
}
.weather-bg-stormy {
  background: linear-gradient(135deg, #2D3748 0%, #1E2A38 100%) !important;
}
.weather-bg-windy {
  background: linear-gradient(135deg, #5A6A7C 0%, #4A5A6C 100%) !important;
}
.weather-bg-night {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%) !important;
}

.weather-snapshot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.weather-snapshot-title {
  font-size: 28rpx;
  font-weight: 600;
  opacity: 0.95;
}

.weather-snapshot-time {
  font-size: 24rpx;
  opacity: 0.8;
}

.weather-snapshot-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.weather-snapshot-icon {
  font-size: 64rpx;
}

.weather-snapshot-temp {
  display: flex;
  flex-direction: column;
}

.temp-value {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.temp-feel {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

.weather-snapshot-text {
  font-size: 28rpx;
  margin-left: auto;
  opacity: 0.9;
}

.weather-snapshot-details {
  display: flex;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  margin-bottom: 16rpx;
}

.detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.detail-label {
  font-size: 20rpx;
  opacity: 0.7;
}

.detail-value {
  font-size: 24rpx;
  font-weight: 500;
}

.aqi-good { color: #A8E6CF; }
.aqi-moderate { color: #FFF3B0; }
.aqi-light-pollution { color: #FFD3B6; }
.aqi-heavy-pollution { color: #FF4D4F; }
.aqi-severe { color: #8B0000; }

.weather-warning {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255, 100, 100, 0.25);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 16rpx;
}

.warning-icon {
  font-size: 28rpx;
}

.warning-text {
  font-size: 24rpx;
  font-weight: 500;
}

.weather-correct {
  display: flex;
  align-items: center;
  gap: 12rpx;
  justify-content: flex-end;
}

.correct-label {
  font-size: 22rpx;
  opacity: 0.7;
}

.correct-picker {
  font-size: 24rpx;
  font-weight: 500;
  opacity: 0.9;
  padding: 6rpx 14rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}

/* 心情选择网格 */
.moods {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.mood {
  background: #FFFFFF;
  border-radius: 20rpx;
  height: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  gap: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(200, 130, 90, 0.06);
  transition: all 0.2s ease;
}

.mood text:first-child {
  font-size: 40rpx;
  line-height: 1;
}

.mood text:last-child {
  font-size: 24rpx;
  color: #6B5A50;
}

.mood.chosen {
  border-color: #E8856A;
  background: linear-gradient(135deg, #FFF1E6, #FFE8DD);
  box-shadow: 0 4rpx 16rpx rgba(232, 133, 106, 0.2);
  transform: scale(1.02);
}

.mood.chosen text:last-child {
  color: #D46A4D;
  font-weight: 600;
}

.mood:active {
  transform: scale(0.95);
}

/* 文本输入 */
textarea {
  width: 100%;
  height: 200rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #4A3A32;
  line-height: 1.7;
  box-shadow: 0 4rpx 12rpx rgba(200, 130, 90, 0.06);
  border: 1rpx solid rgba(232, 133, 106, 0.08);
}

textarea::placeholder {
  color: #C9B9AE;
}

/* ========== 天气影响 ========== */
.impact-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.impact-item {
  padding: 14rpx 28rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #6B5A50;
  border: 1rpx solid #F5E6DB;
  transition: all 0.2s ease;
}

.impact-item.on {
  background: linear-gradient(135deg, #FFE0D0, #FFD0B8);
  color: #D46A4D;
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(232, 133, 106, 0.2);
}

/* ========== 身体感受 ========== */
.body-feelings {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.body-item {
  padding: 14rpx 24rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  font-size: 25rpx;
  color: #6B5A50;
  border: 1rpx solid #F5E6DB;
  transition: all 0.2s ease;
}

.body-item.on {
  background: linear-gradient(135deg, #E6F7FF, #BAE7FF);
  color: #1890FF;
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.2);
}

/* ========== 情绪诱因 ========== */
.trigger-categories {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.trigger-cat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 12rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 12rpx rgba(200, 130, 90, 0.06);
  transition: all 0.2s ease;
}

.trigger-cat.on {
  border-color: #E8856A;
  background: linear-gradient(135deg, #FFF1E6, #FFE8DD);
}

.cat-icon {
  font-size: 36rpx;
}

.cat-label {
  font-size: 24rpx;
  color: #4A3A32;
  font-weight: 500;
}

.trigger-items {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.trigger-item {
  padding: 14rpx 24rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  font-size: 25rpx;
  color: #6B5A50;
  border: 1rpx solid #F5E6DB;
  transition: all 0.2s ease;
}

.trigger-item.on {
  background: linear-gradient(135deg, #FFE0D0, #FFD0B8);
  color: #D46A4D;
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(232, 133, 106, 0.2);
}

/* ========== 场景标签 ========== */
.scene-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(200, 130, 90, 0.06);
  border: 1rpx solid rgba(232, 133, 106, 0.08);
}

.scene-label {
  font-size: 26rpx;
  color: #8B776B;
  margin-bottom: 14rpx;
  font-weight: 500;
}

.scene-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.scene-tags:last-child {
  margin-bottom: 0;
}

.scene-tag {
  padding: 16rpx 24rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: #4A3A32;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.scene-tag.on {
  background: linear-gradient(135deg, #FFF1E6, #FFE8DD);
  border-color: #E8856A;
  color: #D46A4D;
  font-weight: 600;
}

/* 定位区域 */
.location-area {
  margin-bottom: 16rpx;
}

.location-text {
  font-size: 24rpx;
  color: #8B776B;
}

.location-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #52C41A, #73D13D);
  color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(82, 196, 26, 0.3);
}

.location-btn-icon {
  font-size: 32rpx;
}

/* ========== 多媒体区域 ========== */
.media-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(200, 130, 90, 0.06);
  border: 1rpx solid rgba(232, 133, 106, 0.08);
}

/* 图片上传 */
.photos {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.photos image,
.add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
}

.photos image {
  object-fit: cover;
}

.add {
  background: #FAFAFA;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #C9B9AE;
  border: 2rpx dashed #F5DCC8;
  box-sizing: border-box;
  transition: all 0.2s ease;
  gap: 4rpx;
}

.add-text {
  font-size: 20rpx;
  text-align: center;
  line-height: 1.4;
}

.add:active {
  background: #FFF1E6;
  border-color: #E8856A;
  color: #E8856A;
}

/* 录音 */
.audio-section {
  border-top: 1rpx solid #F5E6DB;
  padding-top: 24rpx;
}

.record-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #FFF1E6, #FFE8DD);
  border: 2rpx dashed #E8856A;
  border-radius: 16rpx;
  padding: 32rpx;
  transition: all 0.2s ease;
}

.record-btn.recording {
  background: linear-gradient(135deg, #FF4D4F, #FF7875);
  border-style: solid;
  border-color: #FF4D4F;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.record-icon {
  font-size: 48rpx;
}

.record-text {
  font-size: 26rpx;
  color: #D46A4D;
  font-weight: 500;
}

.record-btn.recording .record-text {
  color: #FFFFFF;
}

.audio-player {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F6FFED;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #B7EB8F;
}

.audio-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.audio-icon {
  font-size: 36rpx;
}

.audio-duration {
  font-size: 26rpx;
  color: #52C41A;
  font-weight: 500;
}

.audio-delete {
  padding: 8rpx 20rpx;
  background: #FFF1F0;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #FF4D4F;
}

/* 保存按钮 */
.save {
  margin: 50rpx 0 20rpx;
}

/* 通用 */
.muted {
  color: #C9B9AE;
  font-size: 24rpx;
  margin-left: 12rpx;
  font-weight: 400;
}

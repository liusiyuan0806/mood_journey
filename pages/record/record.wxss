/* ===== 记录心情 · 温暖色调 ===== */

/* 表单区块 */
.section {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #8B776B;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.picker-box {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #4A3A32;
  box-shadow: 0 4rpx 12rpx rgba(200, 130, 90, 0.06);
  border: 1rpx solid rgba(232, 133, 106, 0.08);
}

/* 心情选择网格 */
.moods {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.mood {
  background: #FFFFFF;
  border-radius: 20rpx;
  height: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  gap: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(200, 130, 90, 0.06);
  transition: all 0.2s ease;
}

.mood text:first-child {
  font-size: 40rpx;
  line-height: 1;
}

.mood text:last-child {
  font-size: 24rpx;
  color: #6B5A50;
}

.mood.chosen {
  border-color: #E8856A;
  background: linear-gradient(135deg, #FFF1E6, #FFE8DD);
  box-shadow: 0 4rpx 16rpx rgba(232, 133, 106, 0.2);
  transform: scale(1.02);
}

.mood.chosen text:last-child {
  color: #D46A4D;
  font-weight: 600;
}

.mood:active {
  transform: scale(0.95);
}

/* 文本输入 */
textarea {
  width: 100%;
  height: 200rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #4A3A32;
  line-height: 1.7;
  box-shadow: 0 4rpx 12rpx rgba(200, 130, 90, 0.06);
  border: 1rpx solid rgba(232, 133, 106, 0.08);
}

textarea::placeholder {
  color: #C9B9AE;
}

/* 选择器行 */
.selectors {
  display: flex;
  gap: 18rpx;
}

.selectors picker {
  flex: 1;
}

.selectors view {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 22rpx;
  font-size: 27rpx;
  color: #4A3A32;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(200, 130, 90, 0.06);
  border: 1rpx solid rgba(232, 133, 106, 0.08);
}

.selectors text {
  color: #C9B9AE;
  font-size: 30rpx;
}

/* 情绪诱因标签 */
.triggers {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.triggers text {
  padding: 14rpx 24rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  font-size: 25rpx;
  color: #6B5A50;
  border: 1rpx solid #F5E6DB;
  transition: all 0.2s ease;
}

.triggers text:active {
  transform: scale(0.95);
}

.triggers .on {
  background: linear-gradient(135deg, #FFE0D0, #FFD0B8);
  color: #D46A4D;
  border-color: transparent;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(232, 133, 106, 0.2);
}

/* 图片上传 */
.photos {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.photos image,
.add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
}

.photos image {
  object-fit: cover;
}

.add {
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #C9B9AE;
  border: 2rpx dashed #F5DCC8;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.add:active {
  background: #FFF1E6;
  border-color: #E8856A;
  color: #E8856A;
}

/* 保存按钮 */
.save {
  margin: 50rpx 0 20rpx;
}

/* ===== 首页 · 温暖色调 ===== */

/* 顶部用户区 */
.top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 10rpx 0 32rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #FFE0D0, #FFD0B8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  box-shadow: 0 4rpx 12rpx rgba(232, 133, 106, 0.15);
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.hello {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A3A32;
  line-height: 1.3;
}

.clock {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #B5A69C;
}

/* 天气卡片 */
.weather {
  padding: 32rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(120deg, #FFFFFF 0%, #FFEFE0 100%);
  position: relative;
  overflow: hidden;
}

.weather::before {
  content: '';
  position: absolute;
  top: -30rpx;
  right: -20rpx;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(240, 178, 122, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.weather-city {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3A32;
  margin-bottom: 10rpx;
}

.weather-info {
  font-size: 44rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #E8856A;
  font-weight: 600;
}

/* 今日心情轨迹 — 时间轴样式，融入页面背景 */
.today-card {
  margin: 20rpx 0 0;
  padding: 0;
  background: transparent;
  box-shadow: none;
  border: none;
}

.today-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 0 4rpx;
}

.today-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3A32;
}

.today-count {
  font-size: 24rpx;
  color: #E8856A;
  background: #FFF1E6;
  padding: 3rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 500;
  justify-content: center;
  align-items: center;
}

/* 时间轴记录项 */
.record-item {
  display: flex;
  padding: 0 0 24rpx 42rpx;
  position: relative;
}

/* 时间轴竖线 */
.record-item::before {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 22rpx;
  bottom: -4rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #F5D5BE 0%, #FFE8DD 100%);
}

.record-item:last-child::before {
  display: none;
}

.record-dot {
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F0B27A, #E8856A);
  flex-shrink: 0;
  box-shadow: 0 3rpx 10rpx rgba(232, 133, 106, 0.35);
  z-index: 1;
  border: 5rpx solid #FFF8F2;
  box-sizing: border-box;
}

.record-body {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(200, 130, 90, 0.06);
  border: 1rpx solid rgba(232, 133, 106, 0.06);
}

.record-time {
  font-size: 23rpx;
  color: #F0B27A;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.emotion-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.record-mood {
  font-size: 28rpx;
  font-weight: 600;
  color: #5D4A40;
}

.record-note {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #8B776B;
  line-height: 1.6;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #B5A69C;
  padding: 48rpx 0;
  font-size: 26rpx;
  background: #FFFBF7;
  border-radius: 20rpx;
  border: 1rpx dashed #F5DCC8;
  margin-left: 42rpx;
}

/* 心情选择网格 */
.moods {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.mood {
  background: #FFFFFF;
  border-radius: 20rpx;
  height: 130rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  gap: 1rpx;
  box-shadow: 0 4rpx 12rpx rgba(200, 130, 90, 0.06);
  transition: all 0.5s ease;
}

.mood:active {
  transform: scale(0.85);
  background: #FFF1E6;
}

.mood .emoji {
  font-size: 40rpx;
  line-height: 1;
  margin-top:-15rpx
}

.mood-text {
  font-size: 28rpx;
  line-height: 1.2;
  color: #6B5A50;
  white-space: nowrap;
  margin-top:-15rpx

}

/* 一句话卡片 */
.quote {
  padding: 30rpx 28rpx;
  color: #7A665C;
  font-size: 27rpx;
  line-height: 1.7;
  margin: 32rpx 0 28rpx;
  text-align: center;
  background: linear-gradient(135deg, #FFFBF7 0%, #FFF1E6 100%);
  font-style: italic;
  letter-spacing: 1rpx;
  position: relative;
}

.quote::before {
  content: '"';
  position: absolute;
  top: 10rpx;
  left: 24rpx;
  font-size: 60rpx;
  color: rgba(232, 133, 106, 0.15);
  font-family: Georgia, serif;
}

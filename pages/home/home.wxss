
.top{
  display:flex;
  align-items:center;
  gap:20rpx;
  margin:18rpx 0 30rpx
}
.user-info{
  display:flex;
  flex-direction:column;
  justify-content:center;
}
.avatar{
  width:92rpx;
  height:92rpx;
  background:#FFE1D4;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:45rpx
}
.avatar-img{
  width:100%;
  height:100%;
  border-radius:50%;
  display:block;
}
.hello{
  font-size:42rpx;
  font-weight:700;
  color:#3E3025;
  line-height:1.2;
}
.weather{
  padding:30rpx;
  display:flex;
  justify-content:space-between;
  align-items:center;
  background:linear-gradient(120deg,#FFF,#FFE8D8)
}
.weather-city{
  font-size:33rpx;
  font-weight:700;
  margin-bottom:12rpx
}
.weather-info{
  font-size:46rpx;
  display:flex;align-items:center;
  gap:14rpx
}
.moods {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.mood {
  background: #fff;
  border-radius: 18rpx;
  height: 106rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  border: 3rpx solid transparent;
  box-sizing:border-box;
  gap:6rpx;
  transform:translateY(-5rpx)
}
/* 首页 emoji 与记录页一致 */
.mood .emoji {
  font-size: 38rpx;
  line-height:1;
  margin-bottom:-20rpx;
  margin-top:-25rpx;
}

/* 
首页文字与记录页一致 */
.mood-text {
  font-size: 25rpx;
  line-height: 1;
  color: #665348;
  white-space: nowrap;
}
.quote{
  padding:26rpx;
  color:#766763;
  font-size:27rpx;
  line-height:1.6;
  margin:32rpx 0 22rpx;
  text-align:center}
/* 与天气卡片拉开距离 */
.today-card{
  margin:40rpx 24rpx;
  padding:30rpx 26rpx;
  border-radius:32rpx;
  background:#FFF9F3;
  box-shadow:0 8rpx 30rpx rgba(200,150,100,.12);
}


.today-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:30rpx;
}


.today-title{
  font-size:34rpx;
  font-weight:700;
  color:#795548;
}


.today-count{
  font-size:26rpx;
  color:#C08A5A;
}

.timeline-item{
  display:flex;
  padding:24rpx 0;
  border-bottom:1rpx solid #F5E8DD;
}


/* 左边小圆点 */
.timeline-left{
  width:40rpx;
  display:flex;
  flex-direction:column;
  align-items:center;
}


.dot{
  width:18rpx;
  height:18rpx;
  border-radius:50%;
  background:#FFB36B;
  margin-top:18rpx;
}


.line{
  flex:1;
  width:2rpx;
  background:#F4DDC8;
}


/* 内容 */
.timeline-content{
  flex:1;
  margin-left:18rpx;
}


/* 时间+emoji+心情 */
.timeline-header{

  display:flex;
  align-items:center;

}


/* 时间 */
.time{

  font-size:32rpx;
  color:#E99345;
  font-weight:700;

}


/* emoji */
.timeline-header .emoji{

  font-size:48rpx;

  margin-left:30rpx;

}







/* ===== 今日心情轨迹新版布局 ===== */


.record-main{

  display:flex;

  align-items:center;

  height:70rpx;

}


/* 时间 */

.record-time{

  width:130rpx;

  font-size:32rpx;

  color:#E99345;

  font-weight:700;

}


/* emoji + 心情 */

.mood-box{

  display:flex;

  align-items:center;

}


/* emoji */

.timeline-emoji{

  font-size:46rpx;

  margin-right:16rpx;

}


/* 心情名称 */

.mood-name{

  font-size:34rpx;

  font-weight:700;

  color:#6B5142;

}


/* 备注 */

.note{

  margin-top:12rpx;

  margin-left:130rpx;

  font-size:28rpx;

  color:#958174;

  line-height:1.5;

}


/* 每条记录缩紧 */

.timeline-item{

  padding:18rpx 0;

}


/* 分隔线淡一点 */

.timeline-item:last-child{

  border-bottom:none;

}














/* 分割线 */
.timeline-item:not(:last-child){
  border-bottom:1rpx solid #F3E5D8;
  margin-bottom:28rpx;
}

.empty{
  text-align:center;
  color:#BFA58A;
  padding:40rpx 0;
}
.clock{
  margin-top:10rpx;
  font-size:26rpx;
  color:#9F8E83;
}

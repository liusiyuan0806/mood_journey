/* ===== 首页 · 温暖色调 + 天气动态背景 ===== */

/* ===== 页面基础 ===== */
.page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  padding-bottom: 60rpx;
  transition: background 0.8s ease;
}

/* ===== 天气动态背景层 ===== */
.bg-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

/* ==================== 动态云朵（所有天气通用） ==================== */
.cloud {
  position: absolute;
  pointer-events: none;
  animation: cloudFloat linear infinite;
}
.cloud::before,
.cloud::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: inherit;
}
.cloud-1 {
  width: 160rpx;
  height: 56rpx;
  top: 8%;
  left: -25%;
  border-radius: 56rpx;
  animation-duration: 36s;
}
.cloud-1::before {
  width: 64rpx; height: 64rpx;
  top: -34rpx; left: 32rpx;
}
.cloud-1::after {
  width: 48rpx; height: 48rpx;
  top: -20rpx; left: 76rpx;
}
.cloud-2 {
  width: 120rpx;
  height: 40rpx;
  top: 22%;
  left: -30%;
  border-radius: 40rpx;
  animation-duration: 28s;
  animation-delay: 6s;
}
.cloud-2::before {
  width: 50rpx; height: 50rpx;
  top: -26rpx; left: 20rpx;
}
.cloud-2::after {
  width: 36rpx; height: 36rpx;
  top: -14rpx; left: 56rpx;
}
.cloud-3 {
  width: 200rpx;
  height: 64rpx;
  top: 52%;
  left: -35%;
  border-radius: 64rpx;
  animation-duration: 44s;
  animation-delay: 12s;
}
.cloud-3::before {
  width: 80rpx; height: 80rpx;
  top: -40rpx; left: 40rpx;
}
.cloud-3::after {
  width: 56rpx; height: 56rpx;
  top: -24rpx; left: 96rpx;
}
.cloud-4 {
  width: 140rpx;
  height: 48rpx;
  top: 68%;
  left: -28%;
  border-radius: 48rpx;
  animation-duration: 32s;
  animation-delay: 3s;
}
.cloud-4::before {
  width: 56rpx; height: 56rpx;
  top: -30rpx; left: 28rpx;
}
.cloud-4::after {
  width: 42rpx; height: 42rpx;
  top: -16rpx; left: 68rpx;
}

@keyframes cloudFloat {
  0%   { transform: translateX(0); }
  100% { transform: translateX(calc(100vw + 200%)); }
}

/* 不同天气下的云朵颜色 */
.bg-sunny .cloud {
  background: rgba(255, 255, 255, 0.55);
  box-shadow: 0 4rpx 20rpx rgba(255, 255, 255, 0.15);
}
.bg-cloudy .cloud {
  background: rgba(200, 200, 210, 0.65);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.bg-rainy .cloud {
  background: rgba(140, 155, 180, 0.45);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.1);
}
.bg-snowy .cloud {
  background: rgba(255, 255, 255, 0.4);
  box-shadow: 0 2rpx 16rpx rgba(255, 255, 255, 0.1);
}
.bg-night .cloud {
  background: rgba(180, 190, 210, 0.18);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* ---------- 晴天背景 ---------- */
.bg-sunny {
  background: linear-gradient(180deg, #FFF5E6 0%, #FFECD2 30%, #FDF2E9 70%, #FFF8F2 100%);
}

/* 晴天光斑 */
.sun-spot {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 200, 120, 0.35) 0%, rgba(255, 220, 160, 0.08) 70%, transparent 100%);
  animation: floatSun 6s ease-in-out infinite;
}
.spot-1 { width: 180rpx; height: 180rpx; top: 15%;  left: -5%;  animation-delay: 0s; }
.spot-2 { width: 120rpx; height: 120rpx; top: 40%;  right: -3%; animation-delay: 2s; }
.spot-3 { width: 100rpx; height: 100rpx; top: 60%;  left: 20%;  animation-delay: 4s; }
.spot-4 { width: 80rpx;  height: 80rpx;  top: 25%;  right: 25%; animation-delay: 1.5s; }
.spot-5 { width: 140rpx; height: 140rpx; top: 50%;  left: 60%;  animation-delay: 3s; }

@keyframes floatSun {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.7; }
  50%      { transform: translateY(-20rpx) scale(1.15); opacity: 0.45; }
}

/* ---------- 阴天背景 ---------- */
.bg-cloudy {
  background: linear-gradient(180deg, #E8ECF1 0%, #DCE1E8 30%, #E3E8ED 60%, #F0F2F5 100%);
}

/* ---------- 雨天背景 ---------- */
.bg-rainy {
  background: linear-gradient(180deg, #4A5568 0%, #5A6578 25%, #4A5568 60%, #3D4A5C 100%);
}

/* CSS 雨滴 */
.rain-drop {
  position: absolute;
  top: -60rpx;
  width: 2rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.55) 60%, rgba(255, 255, 255, 0.2) 100%);
  animation: rainFall linear infinite;
}
@keyframes rainFall {
  0%   { transform: translateY(-60rpx); opacity: 0; }
  10%  { opacity: 1; }
  90%  { opacity: 0.6; }
  100% { transform: translateY(105vh); opacity: 0; }
}
.drop-1  { left: 5%;  height: 50rpx; animation-duration: 0.9s; animation-delay: 0s; }
.drop-2  { left: 15%; height: 40rpx; animation-duration: 1.1s; animation-delay: 0.2s; }
.drop-3  { left: 28%; height: 55rpx; animation-duration: 0.8s; animation-delay: 0.5s; }
.drop-4  { left: 36%; height: 35rpx; animation-duration: 1.0s; animation-delay: 0.1s; }
.drop-5  { left: 44%; height: 48rpx; animation-duration: 0.85s; animation-delay: 0.7s; }
.drop-6  { left: 55%; height: 42rpx; animation-duration: 1.05s; animation-delay: 0.3s; }
.drop-7  { left: 63%; height: 52rpx; animation-duration: 0.9s; animation-delay: 0.6s; }
.drop-8  { left: 72%; height: 38rpx; animation-duration: 0.95s; animation-delay: 0.15s; }
.drop-9  { left: 82%; height: 45rpx; animation-duration: 1.1s; animation-delay: 0.4s; }
.drop-10 { left: 92%; height: 41rpx; animation-duration: 0.88s; animation-delay: 0.25s; }

/* 玻璃雨滴 */
.glass-drop {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 40%, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0.05) 60%, transparent 100%);
  border: 1rpx solid rgba(255,255,255,0.12);
  animation: glassFloat 4s ease-in-out infinite;
}
.gd-1 { width: 30rpx; height: 30rpx; top: 20%; left: 12%; animation-delay: 0s; }
.gd-2 { width: 22rpx; height: 22rpx; top: 50%; left: 75%; animation-delay: 1.5s; }
.gd-3 { width: 26rpx; height: 26rpx; top: 65%; left: 30%; animation-delay: 3s; }

@keyframes glassFloat {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.55; }
  50%      { transform: translateY(-12rpx) scale(1.1); opacity: 0.7; }
}

/* ---------- 雪天背景 ---------- */
.bg-snowy {
  background: linear-gradient(180deg, #D4DFE8 0%, #C8D6E0 30%, #DCE4EC 60%, #E8EEF2 100%);
}

.snow-flake {
  position: absolute;
  top: -40rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  animation: snowFall linear infinite;
  text-shadow: 0 0 8rpx rgba(255,255,255,0.3);
}
@keyframes snowFall {
  0%   { transform: translateY(-40rpx) translateX(0) rotate(0deg); opacity: 0; }
  10%  { opacity: 0.8; }
  50%  { transform: translateY(50vh) translateX(30rpx) rotate(180deg); opacity: 0.6; }
  90%  { opacity: 0.3; }
  100% { transform: translateY(105vh) translateX(-20rpx) rotate(360deg); opacity: 0; }
}
.sf-1 { left: 8%;  animation-duration: 8s;  animation-delay: 0s; font-size: 24rpx; }
.sf-2 { left: 20%; animation-duration: 10s; animation-delay: 1s; font-size: 20rpx; }
.sf-3 { left: 35%; animation-duration: 9s;  animation-delay: 3s; font-size: 28rpx; }
.sf-4 { left: 48%; animation-duration: 11s; animation-delay: 2s; font-size: 22rpx; }
.sf-5 { left: 58%; animation-duration: 8.5s;animation-delay: 4s; font-size: 26rpx; }
.sf-6 { left: 70%; animation-duration: 10.5s;animation-delay: 1.5s;font-size: 20rpx; }
.sf-7 { left: 80%; animation-duration: 9.5s; animation-delay: 3.5s;font-size: 24rpx; }
.sf-8 { left: 92%; animation-duration: 8s;  animation-delay: 2.5s;font-size: 22rpx; }

/* ---------- 夜晚背景 ---------- */
.bg-night {
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 30%, #101828 60%, #0d1b2a 100%);
}

/* 星星 */
.star {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  animation: twinkle 2.5s ease-in-out infinite;
}
@keyframes twinkle {
  0%, 100% { opacity: 0.3; transform: scale(1); }
  50%      { opacity: 1;   transform: scale(1.4); }
}
.star-1  { width: 6rpx;  height: 6rpx;  top: 8%;  left: 15%; animation-delay: 0s; }
.star-2  { width: 4rpx;  height: 4rpx;  top: 12%; left: 35%; animation-delay: 0.8s; }
.star-3  { width: 5rpx;  height: 5rpx;  top: 5%;  left: 55%; animation-delay: 1.6s; }
.star-4  { width: 7rpx;  height: 7rpx;  top: 10%; left: 72%; animation-delay: 0.4s; }
.star-5  { width: 4rpx;  height: 4rpx;  top: 15%; left: 85%; animation-delay: 2.0s; }
.star-6  { width: 5rpx;  height: 5rpx;  top: 18%; left: 25%; animation-delay: 1.2s; }
.star-7  { width: 6rpx;  height: 6rpx;  top: 7%;  left: 45%; animation-delay: 0.6s; }
.star-8  { width: 4rpx;  height: 4rpx;  top: 20%; left: 65%; animation-delay: 1.8s; }
.star-9  { width: 5rpx;  height: 5rpx;  top: 14%; left: 8%;  animation-delay: 2.2s; }
.star-10 { width: 3rpx;  height: 3rpx;  top: 22%; left: 50%; animation-delay: 0.3s; }
.star-11 { width: 6rpx;  height: 6rpx;  top: 9%;  left: 78%; animation-delay: 1.4s; }
.star-12 { width: 4rpx;  height: 4rpx;  top: 16%; left: 40%; animation-delay: 2.5s; }

/* ===== 毛玻璃卡片基类 ===== */
.card-glass {
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  position: relative;
  z-index: 1;
}
.bg-rainy .card-glass {
  background: rgba(255, 255, 255, 0.55);
  border-color: rgba(255, 255, 255, 0.2);
}
.bg-night .card-glass {
  background: rgba(255, 255, 255, 0.25);
  border-color: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.9);
}

/* ===== 顶部用户区（保持原有风格，适配深色背景）===== */
.top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 10rpx 0 32rpx;
  position: relative;
  z-index: 1;
}
.user-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #FFE0D0, #FFD0B8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  box-shadow: 0 4rpx 12rpx rgba(232, 133, 106, 0.15);
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}
.hello {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A3A32;
  line-height: 1.3;
}
.bg-rainy .hello,
.bg-night .hello {
  color: rgba(255, 255, 255, 0.92);
}
.clock {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #B5A69C;
}
.bg-rainy .clock,
.bg-night .clock {
  color: rgba(255, 255, 255, 0.55);
}

/* ================================================================ */
/* 第一层：沉浸式天气情绪卡 */
/* ================================================================ */
.weather-immersive {
  padding: 32rpx 30rpx 20rpx;
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
}

/* 数据来源标签 */
.wi-source {
  position: absolute;
  top: 22rpx;
  right: 28rpx;
  font-size: 20rpx;
  color: #6BBF7A;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 12rpx;
  background: rgba(107, 191, 122, 0.1);
  border-radius: 12rpx;
}
.wi-source-sim {
  color: #B5A69C;
  background: rgba(180, 165, 155, 0.1);
}
.wi-source-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #6BBF7A;
  display: inline-block;
}
.bg-rainy .wi-source,
.bg-night .wi-source {
  color: rgba(255, 255, 255, 0.65);
  background: rgba(255, 255, 255, 0.12);
}

/* 左侧 */
.wi-left {
  flex: 1;
}
.wi-city-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}
.wi-city {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A3A32;
}
.bg-rainy .wi-city,
.bg-night .wi-city {
  color: rgba(255, 255, 255, 0.88);
}
.wi-divider {
  color: #C5B5A8;
  font-size: 24rpx;
}
.bg-rainy .wi-divider,
.bg-night .wi-divider {
  color: rgba(255, 255, 255, 0.4);
}
.wi-type {
  font-size: 26rpx;
  color: #7A665C;
}
.bg-rainy .wi-type,
.bg-night .wi-type {
  color: rgba(255, 255, 255, 0.65);
}
.wi-pick {
  font-size: 22rpx;
  color: #8A7A6E;
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 16rpx;
}
.bg-rainy .wi-pick,
.bg-night .wi-pick,
.bg-snowy .wi-pick {
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.12);
}

/* 温度行 */
.wi-temp-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin: 8rpx 0 14rpx;
}
.wi-temp {
  font-size: 88rpx;
  font-weight: 200;
  color: #E8856A;
  line-height: 1;
  letter-spacing: -4rpx;
}
.bg-rainy .wi-temp {
  color: #A0B4C8;
}
.bg-night .wi-temp {
  color: #8BA4C0;
}
.wi-feels {
  font-size: 26rpx;
  color: #A09088;
}
.bg-rainy .wi-feels,
.bg-night .wi-feels {
  color: rgba(255, 255, 255, 0.55);
}

/* 关怀文案 */
.wi-care {
  font-size: 27rpx;
  color: #6B5A50;
  line-height: 1.65;
  font-style: italic;
  padding-right: 20rpx;
}
.bg-rainy .wi-care {
  color: rgba(255, 255, 255, 0.78);
}
.bg-night .wi-care {
  color: rgba(255, 255, 255, 0.8);
}

/* 右侧图标 */
.wi-icon {
  font-size: 60rpx;
  opacity: 0.85;
  margin-right: 4rpx;
}

/* 底部详情条 */
.wi-details {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(200, 170, 150, 0.15);
}
.bg-rainy .wi-details {
  border-top-color: rgba(255, 255, 255, 0.12);
}
.bg-night .wi-details {
  border-top-color: rgba(255, 255, 255, 0.08);
}
.wi-detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.wi-d-label {
  font-size: 22rpx;
  color: #B5A69C;
}
.bg-rainy .wi-d-label,
.bg-night .wi-d-label {
  color: rgba(255, 255, 255, 0.45);
}
.wi-d-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #5D4A40;
}
.bg-rainy .wi-d-value,
.bg-night .wi-d-value {
  color: rgba(255, 255, 255, 0.8);
}
.wi-aqi.aqi-good {
  color: #6BBF7A;
}

/* 日出日落 */
.wi-sun-row {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 14rpx;
}
.wi-sun {
  font-size: 24rpx;
  color: #968878;
}
.bg-rainy .wi-sun,
.bg-night .wi-sun {
  color: rgba(255, 255, 255, 0.5);
}
.wi-sun-icon {
  margin-right: 6rpx;
}

/* ===== 原有天气卡片（降级保留，无天气数据时显示）===== */
.weather {
  padding: 32rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(120deg, #FFFFFF 0%, #FFEFE0 100%);
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  z-index: 1;
}
.weather::before {
  content: '';
  position: absolute;
  top: -30rpx;
  right: -20rpx;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(240, 178, 122, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}
.weather-city {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3A32;
  margin-bottom: 10rpx;
}
.weather-info {
  font-size: 44rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #E8856A;
  font-weight: 600;
}

/* ================================================================ */
/* 第二层：一问一答式记录 */
/* ================================================================ */

/* 情境化提问 */
.context-question {
  color: #4A3A32;
}
.bg-rainy .context-question,
.bg-night .context-question {
  color: rgba(255, 255, 255, 0.88);
}

/* 天气影响追问面板 */
.weather-impact-panel {
  position: relative;
  z-index: 2;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 28rpx 26rpx 22rpx;
  margin: 20rpx 0 10rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  animation: slideUp 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  border: 1rpx solid rgba(200, 180, 160, 0.15);
}
.bg-rainy .weather-impact-panel,
.bg-night .weather-impact-panel {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-color: rgba(255, 255, 255, 0.2);
}
@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to   { transform: translateY(0);     opacity: 1; }
}

.wi-question {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 22rpx;
}
.wi-q-icon {
  font-size: 36rpx;
}
.wi-q-text {
  font-size: 29rpx;
  font-weight: 600;
  color: #4A3A32;
}
.bg-rainy .wi-q-text,
.bg-night .wi-q-text {
  color: rgba(255, 255, 255, 0.9);
}

.wi-options {
  display: flex;
  gap: 14rpx;
}
.wi-opt {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: linear-gradient(135deg, #FFF5ED, #FFF1E6);
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #6B5A50;
  transition: all 0.2s;
  border: 2rpx solid transparent;
}
.bg-rainy .wi-opt,
.bg-night .wi-opt {
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.85);
}
.wi-opt:active {
  background: #F0B27A;
  color: #FFFFFF;
  transform: scale(0.94);
}

.wi-skip {
  text-align: center;
  margin-top: 18rpx;
  font-size: 25rpx;
  color: #B5A69C;
  padding: 8rpx 0;
}
.bg-rainy .wi-skip,
.bg-night .wi-skip {
  color: rgba(255, 255, 255, 0.45);
}

/* ===== 今日心情轨迹 — 时间轴样式 ===== */
.today-card {
  margin: 20rpx 0 0;
  padding: 0;
  background: transparent;
  box-shadow: none;
  border: none;
  position: relative;
  z-index: 1;
}
.today-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 0 4rpx;
}
.today-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3A32;
}
.bg-rainy .today-title,
.bg-night .today-title {
  color: rgba(255, 255, 255, 0.88);
}
.today-count {
  font-size: 24rpx;
  color: #E8856A;
  background: #FFF1E6;
  padding: 3rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.bg-rainy .today-count,
.bg-night .today-count {
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.8);
}

/* 时间轴记录项 */
.record-item {
  display: flex;
  padding: 0 0 24rpx 42rpx;
  position: relative;
}
.record-item::before {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 22rpx;
  bottom: -4rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #F5D5BE 0%, #FFE8DD 100%);
}
.bg-rainy .record-item::before {
  background: linear-gradient(180deg, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.08) 100%);
}
.bg-night .record-item::before {
  background: linear-gradient(180deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0.05) 100%);
}
.record-item:last-child::before {
  display: none;
}
.record-dot {
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F0B27A, #E8856A);
  flex-shrink: 0;
  box-shadow: 0 3rpx 10rpx rgba(232, 133, 106, 0.35);
  z-index: 1;
  border: 5rpx solid #FFF8F2;
  box-sizing: border-box;
}
.record-body {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(200, 130, 90, 0.06);
  border: 1rpx solid rgba(232, 133, 106, 0.06);
}
.bg-rainy .record-body {
  background: rgba(255, 255, 255, 0.55);
  border-color: rgba(255, 255, 255, 0.15);
}
.bg-night .record-body {
  background: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.08);
}
.record-time {
  font-size: 23rpx;
  color: #F0B27A;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.emotion-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.record-emoji {
  font-size: 40rpx;
  line-height: 1;
}
.record-mood {
  font-size: 28rpx;
  font-weight: 600;
  color: #5D4A40;
}
.bg-rainy .record-mood,
.bg-night .record-mood {
  color: rgba(255, 255, 255, 0.85);
}
.record-note {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #8B776B;
  line-height: 1.6;
}
.bg-rainy .record-note,
.bg-night .record-note {
  color: rgba(255, 255, 255, 0.65);
}

/* 空状态 */
.empty {
  text-align: center;
  color: #B5A69C;
  padding: 48rpx 0;
  font-size: 26rpx;
  background: #FFFBF7;
  border-radius: 20rpx;
  border: 1rpx dashed #F5DCC8;
  margin-left: 42rpx;
}
.bg-rainy .empty {
  background: rgba(255, 255, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.6);
}
.bg-night .empty {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.45);
}

/* ================================================================ */
/* 第三层：即时反馈卡片 */
/* ================================================================ */
.feedback-card {
  padding: 24rpx 28rpx;
  margin: 24rpx 0 10rpx;
  animation: fadeInUp 0.5s ease;
  background: linear-gradient(135deg, rgba(255, 251, 247, 0.95), rgba(255, 246, 236, 0.92));
}
.bg-rainy .feedback-card {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}
.bg-night .feedback-card {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}
@keyframes fadeInUp {
  from { transform: translateY(30rpx); opacity: 0; }
  to   { transform: translateY(0);     opacity: 1; }
}
.fb-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.fb-icon {
  font-size: 30rpx;
}
.fb-title {
  font-size: 25rpx;
  font-weight: 600;
  color: #E8856A;
  flex: 1;
}
.bg-rainy .fb-title,
.bg-night .fb-title {
  color: rgba(255, 255, 255, 0.75);
}
.fb-close {
  font-size: 30rpx;
  color: #C5B5A8;
  padding: 6rpx 10rpx;
}
.bg-rainy .fb-close,
.bg-night .fb-close {
  color: rgba(255, 255, 255, 0.45);
}
.fb-body {
  font-size: 27rpx;
  color: #5D4A40;
  line-height: 1.7;
  font-style: italic;
}
.bg-rainy .fb-body,
.bg-night .fb-body {
  color: rgba(255, 255, 255, 0.82);
}

/* ===== 心情选择网格（保持原有）===== */
.moods {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  position: relative;
  z-index: 1;
}
.mood {
  background: #FFFFFF;
  border-radius: 20rpx;
  height: 130rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  gap: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(200, 130, 90, 0.06);
  transition: all 0.5s ease;
}
.bg-rainy .mood {
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}
.bg-night .mood {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
}
.mood:active {
  transform: scale(0.85);
  background: #FFF1E6;
}
.mood .emoji {
  font-size: 40rpx;
  line-height: 1;
  margin-top:-5rpx;
}
.mood-text {
  font-size: 28rpx;
  line-height: 1.4;
  color: #6B5A50;
  white-space: nowrap;
  margin-top:-8rpx;
}
.bg-rainy .mood-text,
.bg-night .mood-text {
  color: rgba(255, 255, 255, 0.8);
}

/* 通用 section-title */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3A32;
  margin: 28rpx 0 18rpx;
  position: relative;
  z-index: 1;
}
.bg-rainy .section-title,
.bg-night .section-title {
  color: rgba(255, 255, 255, 0.85);
}
.muted {
  font-size: 24rpx;
  color: #B5A69C;
  font-weight: 400;
}

/* ===== 一句话卡片（保持原有）===== */
.quote {
  padding: 30rpx 28rpx;
  color: #7A665C;
  font-size: 27rpx;
  line-height: 1.7;
  margin: 32rpx 0 28rpx;
  text-align: center;
  background: linear-gradient(135deg, #FFFBF7 0%, #FFF1E6 100%);
  font-style: italic;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
  border-radius: 20rpx;
}
.bg-rainy .quote {
  background: rgba(255, 255, 255, 0.35);
  color: rgba(255, 255, 255, 0.75);
}
.bg-night .quote {
  background: rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.65);
}
.quote::before {
  content: '"';
  position: absolute;
  top: 10rpx;
  left: 24rpx;
  font-size: 60rpx;
  color: rgba(232, 133, 106, 0.15);
  font-family: Georgia, serif;
}

/* ===== 按钮 ===== */
.primary-btn {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
}

.card {
  z-index: 1;
  position: relative;
}

/* ===== 编辑资料 · 温暖色调 ===== */

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  margin: 50rpx auto 16rpx;
  background: linear-gradient(135deg, #FFE0D0, #FFD0B8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 68rpx;
  box-shadow: 0 6rpx 20rpx rgba(232, 133, 106, 0.2);
}

.avatar image {
  width: 100%;
  height: 100%;
}

.avatar:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.hint {
  text-align: center;
  color: #B5A69C;
  font-size: 24rpx;
  margin-bottom: 48rpx;
}

.field {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin: 20rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(200, 130, 90, 0.06);
  border: 1rpx solid rgba(232, 133, 106, 0.08);
}

.field text {
  display: block;
  font-size: 24rpx;
  color: #8B776B;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.field input {
  font-size: 30rpx;
  color: #4A3A32;
}

.field input::placeholder {
  color: #C9B9AE;
}

.primary-btn {
  margin-top: 50rpx;
}
